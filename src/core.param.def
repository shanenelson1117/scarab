/********TOP-DOWN
 * PARAMETERS********************************************************/
DEF_PARAM(topdown_fu_exec_few, TOPDOWN_FU_EXEC_FEW, uns, uns, 0, )
DEF_PARAM(td_load_track_enable, TD_LOAD_TRACK_ENABLE, Flag, Flag, FALSE, )
DEF_PARAM(td_load_dir, TD_LOAD_DIR, char*, string, ".", )
DEF_PARAM(td_load_replay, TD_LOAD_REPLAY, Flag, Flag, FALSE, )
DEF_PARAM(td_load_replay_key, TD_LOAD_REPLAY_KEY, char*, string, "pc", )
DEF_PARAM(td_load_replay_thresh, TD_LOAD_REPLAY_THRESH, float, float, 0.0, )
/* Randomized equal-cardinality force-hit control. When TRUE, instead of force-hitting the keys
 * whose mean membound ratio > td_load_replay_thresh, force-hit a seeded-random set of the SAME
 * cardinality (N = #keys above thresh) drawn from all recorded keys. Isolates the value of the
 * membound *selection* from force-hitting an equal-size arbitrary set. td_load_replay_seed makes
 * the draw reproducible (per simpoint's own key universe). */
DEF_PARAM(td_load_replay_random, TD_LOAD_REPLAY_RANDOM, Flag, Flag, FALSE, )
DEF_PARAM(td_load_replay_seed, TD_LOAD_REPLAY_SEED, uns, uns, 0, )
DEF_PARAM(td_load_evict_track, TD_LOAD_EVICT_TRACK, Flag, Flag, FALSE, )
DEF_PARAM(td_load_evict_start_thresh, TD_LOAD_EVICT_START_THRESH, float, float, -1.0, )
DEF_PARAM(td_load_evict_end_thresh, TD_LOAD_EVICT_END_THRESH, float, float, -1.0, )
DEF_PARAM(td_load_rrip_mark, TD_LOAD_RRIP_MARK, Flag, Flag, FALSE, )
/* Marked-RRIP: the "basic" (unprotected) initial RRPV -- what a line inserts at when nothing
   marked it, i.e. no fraction was staged (prefetch fill, off-path, no demanding op) or the
   fraction did not clear the class threshold. It is also the least-protected end of the
   extrapolation ramp. Shared by every marked-RRIP caller (L1I, L1D, MLC) so all levels agree
   on what "unprotected" means.
   Default 3 = RRIP_DISTANT_VAL-1. NOTE this is NOT the lowest priority: srrip_update_evict
   evicts on reference_val == RRIP_DISTANT_VAL (4), so 3 is one aging round above the floor
   and 4 is evict-on-arrival. Setting it to 4 makes unmarked lines the first victims (a
   BRRIP-distant / pseudo-bypass insertion). Values ABOVE 4 are unsafe -- the eviction test is
   an exact equality, so such a line would never match and would age forever -- and are clamped
   to 4. Negative values are allowed (they protect unmarked lines) but make the "marked"
   distinction meaningless unless td_*_min_rrpv is pushed lower still. */
DEF_PARAM(marked_rrip_basic_rrpv, MARKED_RRIP_BASIC_RRPV, int, int, 3, )
/* Marked-RRIP (REPL_MARKED_RRIP) protects memory-bound load lines. The demanding load's
   memory-bound fraction is computed ON DEMAND at fill (td_mem_cycles/td_window_cycles, as
   the record pass measures it) -- no record CSV, so --td_load_dir / --td_load_replay_key
   are unused by this policy.
   Most-protected (minimum) initial RRPV. May be negative (reference_val is stored signed;
   each unit below 0 buys one extra global aging round of protection). When extrapolation is
   off, a load above the threshold inserts at exactly this value. Default 0 = marked=RRPV-0. */
DEF_PARAM(td_load_rrip_min_rrpv, TD_LOAD_RRIP_MIN_RRPV, int, int, 0, )
/* Gate: when TRUE, derive the initial RRPV from the load's on-demand memory-bound fraction,
   interpolating in [td_load_rrip_min_rrpv, RRIP_DISTANT_VAL-1] (fraction 1.0 -> min, most
   protected); the ramp's lower bound is td_load_rrip_extrap_anchor, and any fraction below
   the anchor inserts at basic. When FALSE, the load gets td_load_rrip_min_rrpv iff its
   fraction exceeds TD_LOAD_REPLAY_THRESH, else basic. */
DEF_PARAM(td_load_rrip_extrapolate, TD_LOAD_RRIP_EXTRAPOLATE, Flag, Flag, FALSE, )
/* Extrapolation mode only: the SOLE lower bound of the ramp (the fraction that maps to the
   basic non-prioritized insert value). Fractions below the anchor insert at basic; the
   replay threshold is NOT consulted in extrapolate mode. Negative => fall back to
   TD_LOAD_REPLAY_THRESH. */
DEF_PARAM(td_load_rrip_extrap_anchor, TD_LOAD_RRIP_EXTRAP_ANCHOR, float, float, -1.0, )
/* Apply the marked-RRIP policy (and all td_load_rrip_* knobs) to the L2 / MLC instead of the
   L1 D-cache. When TRUE (with td_load_rrip_mark), the MLC uses REPL_MARKED_RRIP -- its fills
   derive the initial RRPV from the demanding load's on-demand membound fraction and its hits
   use the predictor -- and the L1 D-cache reverts to its normal DCACHE_REPL policy. FALSE =
   the policy stays on the L1 D-cache (default). */
DEF_PARAM(td_load_rrip_on_mlc, TD_LOAD_RRIP_ON_MLC, Flag, Flag, FALSE, )
/* Marked-RRIP hit-promotion predictor. When TRUE, a hit re-derives the line's RRPV from a
   PC-indexed EWMA of the accessing load's measured miss memory-bound fraction (its
   counterfactual "how membound it would have been if it had missed") via the same
   min/anchor/extrapolate math, instead of restoring min(0, the inserted RRPV). Warmup (a PC
   with no recorded miss) falls back to that legacy behavior. FALSE = legacy behavior for
   every hit. Requires td_load_rrip_mark. */
DEF_PARAM(td_load_rrip_hit_predict, TD_LOAD_RRIP_HIT_PREDICT, Flag, Flag, FALSE, )
/* EWMA weight for the per-PC membound predictor, in (0,1]: pred = (1-a)*pred + a*measured.
   Larger = tracks recent misses faster. Values <=0 or >1 are clamped to the 0.25 default. */
DEF_PARAM(td_load_rrip_pred_alpha, TD_LOAD_RRIP_PRED_ALPHA, float, float, 0.25, )

/* ---- L1I front-end-bound marked-RRIP (analogous to the L1D/L2 membound policy) ---------
   Apply REPL_MARKED_RRIP to the L1 instruction cache, protecting lines whose fetch miss
   actually stalled the front end. Per demand icache miss the fill derives an initial RRPV
   from the FE-bound fraction = fe_bound_cycles / fe_window_cycles (of the cycles the miss
   was outstanding, how many the front end was starving the machine). Own knob set so the
   L1I can be tuned independently of the L1D/L2 policy (they merge later). */
DEF_PARAM(td_fe_rrip_mark, TD_FE_RRIP_MARK, Flag, Flag, FALSE, )
/* Apply the front-end-bound (instruction) marked-RRIP policy to the L2/MLC instead of the
   L1I: an instruction demand-fetch fill (MRT_IFETCH) derives its L2 RRPV from the fetch
   miss's front-end-bound fraction (measured at the L1I), while ALL DATA lines -- and
   instruction prefetches -- insert at basic. Mutually exclusive with td_load_rrip_on_mlc
   (that one puts the data membound policy on the L2). Uses the same td_fe_rrip_* knobs. */
DEF_PARAM(td_fe_rrip_on_mlc, TD_FE_RRIP_ON_MLC, Flag, Flag, FALSE, )
/* COMBINED L2 policy: apply the marked-RRIP policy to the L2/MLC for BOTH classes at once,
   each with its own knob set --
     data lines        -> membound fraction (td_mem_cycles/td_window_cycles), td_load_rrip_*
                          knobs (min td_load_rrip_min_rrpv, gate td_load_replay_thresh);
     instruction lines -> front-end-bound fraction (measured at the L1I), td_fe_rrip_* knobs
                          (min td_fe_rrip_min_rrpv, gate td_fe_rrip_thresh).
   Prefetches / anything without a demanding op insert at basic. Set both extrapolate flags
   to 0 to statically assign per-class minimum RRPVs and thresholds. Supersedes / is mutually
   exclusive with td_load_rrip_on_mlc and td_fe_rrip_on_mlc. */
DEF_PARAM(td_combined_on_mlc, TD_COMBINED_ON_MLC, Flag, Flag, FALSE, )
/* The same combined policy on the LLC (Scarab's l1_* cache) instead of / as well as the MLC.
   Both signals resolve at any level -- the instruction fraction is looked up by line address
   and the data fraction hangs off the request -- and the LLC fills BEFORE the MLC on the
   return path, so the demanding op is at least as likely to still be live.
   STATIC MODE ONLY: td_combined_set_duel, td_combined_dynamic_depth and
   td_combined_dynamic_thresh remain MLC-only (their leader-set map and selection state are
   per-proc and bound to the MLC's geometry), so the LLC uses the fixed td_fe_rrip_min_rrpv /
   td_load_rrip_min_rrpv depths and their thresholds.
   Note the LLC is 16-way where the MLC is 8-way, so aging per fill differs -- MLC-tuned
   depths do NOT carry over and must be re-swept. */
DEF_PARAM(td_combined_on_l1, TD_COMBINED_ON_L1, Flag, Flag, FALSE, )
/* Combined L2 DYNAMIC depth: instead of static per-class depths, bucket by the running
   balance of front-end-bound vs mem-bound cycles and pick which class is protected deep.
   fe_frac = fe_bound_cycles / (fe_bound_cycles + mem_bound_cycles) over a window:
     fe_frac >= td_combined_dyn_fe_hi -> front-end-dominated: instructions deep
                                         (td_fe_rrip_min_rrpv), data basic;
     fe_frac <= td_combined_dyn_fe_lo -> memory-dominated:   data deep
                                         (td_load_rrip_min_rrpv), instructions basic;
     in between                       -> balanced: BOTH deep (the non-zero-sum region).
   Requires td_combined_on_mlc. */
DEF_PARAM(td_combined_dynamic_depth, TD_COMBINED_DYNAMIC_DEPTH, Flag, Flag, FALSE, )
/* Window (cycles) over which the fe-vs-mem balance is measured; the bucket updates once per
   window from the just-completed window. 0 = cumulative (whole run, computed live). */
DEF_PARAM(td_combined_dyn_window, TD_COMBINED_DYN_WINDOW, uns, uns, 100000, )
/* Bucket boundaries on fe_frac (in [0,1]). <= lo -> memory-dominated; >= hi -> front-end-
   dominated; strictly between -> balanced (both classes deep). In GRADUATED mode
   (td_combined_dyn_buckets >= 2) these instead define the input WINDOW the buckets span:
   fe_frac is normalized as (fe-lo)/(hi-lo) clamped to [0,1] before bucketing, so fe<=lo pins to
   the memory-extreme bucket and fe>=hi to the front-end-extreme bucket. Set the window over the
   observed fe_frac range (e.g. a memory-bound-heavy suite where fe never exceeds ~0.35 wants
   hi~0.35) so every bucket resolves the real population instead of most sitting empty. */
DEF_PARAM(td_combined_dyn_fe_lo, TD_COMBINED_DYN_FE_LO, float, float, 0.33, )
DEF_PARAM(td_combined_dyn_fe_hi, TD_COMBINED_DYN_FE_HI, float, float, 0.66, )
/* Graduated dynamic depth: instead of the 3-way (fe / balanced / mem) split, quantize fe_frac
   into this many buckets over the [fe_lo, fe_hi] window and INTERPOLATE each class's depth --
   basic at the class's far end, suite max (td_*_rrip_min_rrpv) at the window middle, extreme
   (td_combined_dyn_*_extreme) at its near end -- so each successive bucket toward an end pushes
   that class more extreme (and the other toward basic). 0/1 = the 3-bucket fe_lo/fe_hi behavior.
   Depth mode only. */
DEF_PARAM(td_combined_dyn_buckets, TD_COMBINED_DYN_BUCKETS, uns, uns, 0, )
/* Depth for the DOMINANT class in an extreme window. The balanced window uses the suite-wide
   max (td_fe_rrip_min_rrpv / td_load_rrip_min_rrpv). In a strongly one-sided window the
   dominant class may go BELOW (deeper than) that max -- a heavily front-end- or memory-bound
   phase can justify more protection than the suite average -- while the other class drops to
   basic. Set these more negative than the balanced depths. */
DEF_PARAM(td_combined_dyn_instr_extreme, TD_COMBINED_DYN_INSTR_EXTREME, int, int, -64, )
DEF_PARAM(td_combined_dyn_data_extreme, TD_COMBINED_DYN_DATA_EXTREME, int, int, -48, )
/* Dynamic-THRESHOLD variant of the above: instead of moving per-class DEPTH, hold both depths
   at the suite max (td_fe_rrip_min_rrpv / td_load_rrip_min_rrpv) and move the qualification
   THRESHOLDS by the fe-vs-mem balance. In a one-sided window the dominant class gets a LOWER
   threshold (more of it qualifies for protection) and the non-dominant class is turned off (no
   line qualifies -> basic); a balanced window uses the nominal thresholds. Mutually exclusive
   with td_combined_dynamic_depth (depth wins if both are set). */
DEF_PARAM(td_combined_dynamic_thresh, TD_COMBINED_DYNAMIC_THRESH, Flag, Flag, FALSE, )
/* Threshold for the DOMINANT class in an extreme window; lower than the balanced threshold
   (td_fe_rrip_thresh / td_load_replay_thresh) broadens that class's protection. */
DEF_PARAM(td_combined_dyn_instr_thr_extreme, TD_COMBINED_DYN_INSTR_THR_EXTREME, float, float, 0.3, )
DEF_PARAM(td_combined_dyn_data_thr_extreme, TD_COMBINED_DYN_DATA_THR_EXTREME, float, float, 0.2, )
/* DRRIP-style SET DUELING selector for the combined L2 policy. 3 leader groups
   (td_combined_duel_sets_per_group sets each) permanently run a fixed (instr,data) depth bin --
   d32, i48d32, i48 -- and every window the bin with the FEWEST demand misses on its leader sets
   is chosen; all follower sets adopt that bin's depths for the next window. Learns the
   data-vs-instruction protection
   balance online from real miss feedback instead of the modeled top-down counter. Mutually
   exclusive with td_combined_dynamic_depth / td_combined_dynamic_thresh (set-duel wins if more
   than one is set); requires td_combined_on_mlc. */
DEF_PARAM(td_combined_set_duel, TD_COMBINED_SET_DUEL, Flag, Flag, FALSE, )
/* Set-dueling selection window, in RETIRED INSTRUCTIONS per proc (not cycles). */
DEF_PARAM(td_combined_duel_window, TD_COMBINED_DUEL_WINDOW, uns, uns, 100000, )
/* Leader sets per bin. There are 3 bins (d32, i48d32, i48), so 3 * this many leader sets are
   spread uniformly across the L2; the rest are followers. Equal per bin so raw leader miss
   counts are directly comparable. Clamped so 3 * value <= num_sets. */
DEF_PARAM(td_combined_duel_sets_per_group, TD_COMBINED_DUEL_SETS_PER_GROUP, uns, uns, 16, )
/* Sets per leader group for the two BASIC-RRPV groups of the duel (the depth groups use
   td_combined_duel_sets_per_group above). Separate because the basic groups are exploratory --
   they re-test the incumbent depth at the two non-selected basic RRPVs -- so they can be
   smaller than the depth groups. Default 8 gives 3*16 + 2*8 = 64 leader sets, 12.5% of a
   512-set L2 (the previous 3-group scheme used 48, 9.4%). Both counts are scaled down
   together if they would not fit the cache. */
DEF_PARAM(td_combined_duel_basic_sets_per_group, TD_COMBINED_DUEL_BASIC_SETS_PER_GROUP, uns, uns, 8, )
/* Enable the BASIC-RRPV axis of the duel. TRUE (default): 5 leader groups -- 3 sweeping the
   depth bin plus 2 sweeping the unmarked ("basic") RRPV over {2,3,4}, and the duel owns basic
   on the MLC. FALSE: the 2 basic groups are not allocated at all, only the 3 depth groups
   duel, and basic reverts to the global --marked_rrip_basic_rrpv -- i.e. the depth-only
   dueling behaviour from before the basic axis was added. Use FALSE to measure what the basic
   axis is actually worth. */
DEF_PARAM(td_combined_duel_basic_axis, TD_COMBINED_DUEL_BASIC_AXIS, Flag, Flag, TRUE, )
/* Most-protected (minimum) initial RRPV for a front-end-bound icache line; may be negative
   (signed reference_val). extrapolate off => a miss above td_fe_rrip_thresh inserts here. */
DEF_PARAM(td_fe_rrip_min_rrpv, TD_FE_RRIP_MIN_RRPV, int, int, 0, )
/* Gate: when TRUE, interpolate the FE-bound fraction to an RRPV in [min, RRIP_DISTANT_VAL-1]
   with the ramp anchored at td_fe_rrip_extrap_anchor. When FALSE, a miss whose FE-bound
   fraction exceeds td_fe_rrip_thresh inserts at min, else basic. */
DEF_PARAM(td_fe_rrip_extrapolate, TD_FE_RRIP_EXTRAPOLATE, Flag, Flag, FALSE, )
/* Extrapolation mode only: sole lower bound of the ramp; FE-bound fractions below the anchor
   insert at basic. Negative => fall back to td_fe_rrip_thresh. */
DEF_PARAM(td_fe_rrip_extrap_anchor, TD_FE_RRIP_EXTRAP_ANCHOR, float, float, -1.0, )
/* Fixed-min gate / default anchor for the L1I FE-bound policy. */
DEF_PARAM(td_fe_rrip_thresh, TD_FE_RRIP_THRESH, float, float, 0.5, )

/********NODE TABLE
 * PARAMETERS********************************************************/
DEF_PARAM(issue_width, ISSUE_WIDTH, uns, uns, 4, )
DEF_PARAM(rs_fill_width, RS_FILL_WIDTH, uns, uns, 8, )
DEF_PARAM(node_table_size, NODE_TABLE_SIZE, uns, uns, 256, )
DEF_PARAM(node_ret_width, NODE_RET_WIDTH, uns, uns, 4, )
DEF_PARAM(node_retire_rate, NODE_RETIRE_RATE, uns, uns, 10, )

/********DECODE WIDTH
 * PARAMETERS*********************************************************/
/*The maximum number of uops that can be produced by the decoders per cycle,
 * which will be used in icache_stage.c and decode_stage.c.*/
/*E.g., in sunny cove, the issue width is 6, same as the uop cache issue width,
 * while the decode path has a width of 5.*/
DEF_PARAM(decode_width, DECODE_WIDTH, uns, uns, 4, )

/********INSTRUCTION DECODE QUEUE
 * PARAMETERS********************************************************/
DEF_PARAM(idq_size, IDQ_SIZE, uns, uns, 140, )

