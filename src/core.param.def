/* functional unit delays by op_type */
/* note: memory delays correspond to address computation time.  This
   is currently modeled as non-pipelined. */
/* Default delays for most common ops come from Nehalem/Sandybridge as
   described in http://www.agner.org/optimize/microarchitecture.pdf */
DEF_PARAM(op_inv_delay, OP_INV_DELAY, int, int, 1, )
DEF_PARAM(op_nop_delay, OP_NOP_DELAY, int, int, 1, )
DEF_PARAM(op_cf_delay, OP_CF_DELAY, int, int, 1, )
DEF_PARAM(op_mov_delay, OP_MOV_DELAY, int, int, 1, )
DEF_PARAM(op_cmov_delay, OP_CMOV_DELAY, int, int, 1, )
DEF_PARAM(op_lda_delay, OP_LDA_DELAY, int, int, 1, )
DEF_PARAM(op_ild_delay, OP_ILD_DELAY, int, int, 1, )
DEF_PARAM(op_ist_delay, OP_IST_DELAY, int, int, 1, )
DEF_PARAM(op_iadd_delay, OP_IADD_DELAY, int, int, 1, )
DEF_PARAM(op_imul_delay, OP_IMUL_DELAY, int, int, 3, )
DEF_PARAM(op_idiv_delay, OP_IDIV_DELAY, int, int, -20, )
DEF_PARAM(op_icmp_delay, OP_ICMP_DELAY, int, int, 1, )
DEF_PARAM(op_logic_delay, OP_LOGIC_DELAY, int, int, 1, )
DEF_PARAM(op_shift_delay, OP_SHIFT_DELAY, int, int, 1, )
DEF_PARAM(op_fld_delay, OP_FLD_DELAY, int, int, 1, )
DEF_PARAM(op_fst_delay, OP_FST_DELAY, int, int, 1, )
DEF_PARAM(op_fcvt_delay, OP_FCVT_DELAY, int, int, 3, )
DEF_PARAM(op_fadd_delay, OP_FADD_DELAY, int, int, 3, )
DEF_PARAM(op_fmul_delay, OP_FMUL_DELAY, int, int, 5, )
DEF_PARAM(op_fma_delay, OP_FMA_DELAY, int, int, 5, )
DEF_PARAM(op_fdiv_delay, OP_FDIV_DELAY, int, int, -20, )
DEF_PARAM(op_fcmp_delay, OP_FCMP_DELAY, int, int, 3, )
DEF_PARAM(op_fcmov_delay, OP_FCMOV_DELAY, int, int, 1, )
DEF_PARAM(op_gather_delay, OP_GATHER_DELAY, int, int, 12, )
DEF_PARAM(op_scatter_delay, OP_SCATTER_DELAY, int, int, 18, )
DEF_PARAM(op_pipelined_fast_delay, OP_PIPELINED_FAST_DELAY, int, int, 2, )
DEF_PARAM(op_pipelined_medium_delay, OP_PIPELINED_MEDIUM_DELAY, int, int, 5, )
DEF_PARAM(op_pipelined_slow_delay, OP_PIPELINED_SLOW_DELAY, int, int, 10, )
DEF_PARAM(op_notpipelined_medium_delay, OP_NOTPIPELINED_MEDIUM_DELAY, int, int,
          -5, )
DEF_PARAM(op_notpipelined_slow_delay, OP_NOTPIPELINED_SLOW_DELAY, int, int,
          -20, )
DEF_PARAM(op_notpipelined_very_slow_delay, OP_NOTPIPELINED_VERY_SLOW_DELAY, int,
          int, -100, )

/* if non-zero, overrides above params to specify the same delay for all op
 * types */
DEF_PARAM(uniform_op_delay, UNIFORM_OP_DELAY, int, int, 0, )

DEF_PARAM(stall_on_wait_mem, STALL_ON_WAIT_MEM, Flag, Flag, TRUE, )
DEF_PARAM(stores_do_not_block_window, STORES_DO_NOT_BLOCK_WINDOW, Flag, Flag,
          FALSE, )
DEF_PARAM(prefs_do_not_block_window, PREFS_DO_NOT_BLOCK_WINDOW, Flag, Flag,
          FALSE, )

/* obey_reg_dep, if false, will cause the map_stage to wipe out all
   the source op information as if the source op had already retired */
DEF_PARAM(obey_reg_dep, OBEY_REG_DEP, Flag, Flag, TRUE, )

DEF_PARAM(track_l1_miss_deps, TRACK_L1_MISS_DEPS, Flag, Flag, FALSE, )

DEF_PARAM(branch_load_dep, BRANCH_LOAD_DEP, Flag, Flag, FALSE, )
/* Multiplicative age threshold for branch-feeder line protection.
   Evict the feeder instead of the LRU non-feeder when:
     (sim_time - feeder_lru_time) > (sim_time - nonfeeder_lru_time) * threshold
   0.0 = strict protection (feeder never evicted while a non-feeder exists). */
DEF_PARAM(branch_load_dep_repl_threshold, BRANCH_LOAD_DEP_REPL_THRESHOLD, float, float, 0.0, )
DEF_PARAM(branch_load_dep_repl, BRANCH_LOAD_DEP_REPL, Flag, Flag, FALSE, )
/* Reprieve budget for branch-feeder line protection (count-based).
   When >0, a feeder line that would be the LRU victim is spared and its budget
   decremented; it only becomes evictable after it has been the LRU victim N
   times (i.e. N times it "should have been evicted" under plain LRU). A demand
   hit on the feeder line refills the budget back to N. 0 disables the counter
   scheme (falls back to the BRANCH_LOAD_DEP_REPL_THRESHOLD age-ratio policy). */
DEF_PARAM(branch_load_dep_repl_n, BRANCH_LOAD_DEP_REPL_N, uns, uns, 0, )
/* RRIP-family analogue of the LRU reprieve scheme: when a D-cache line is
   (re)marked as a branch feeder and the cache uses SRRIP/BRRIP/DRRIP, install it
   at reference_val = BRANCH_LOAD_DEP_REPL_RRIP_RRPV instead of the default RRIP
   insertion value, giving feeders longer residency. Independent of
   BRANCH_LOAD_DEP_REPL / _repl_n (those only affect LRU). */
DEF_PARAM(branch_load_dep_repl_rrip,      BRANCH_LOAD_DEP_REPL_RRIP,      Flag, Flag, FALSE, )
/* RRPV to give feeders on (re)mark; 0 = strongest (like a fresh hit). Clamped to
   [0, RRIP_DISTANT_VAL-1] so a feeder is never inserted as immediately evictable. */
DEF_PARAM(branch_load_dep_repl_rrip_rrpv, BRANCH_LOAD_DEP_REPL_RRIP_RRPV, uns,  uns,  0,     )
DEF_PARAM(branch_load_dep_prefetch, BRANCH_LOAD_DEP_PREFETCH, Flag, Flag, FALSE, )
DEF_PARAM(branch_load_dep_zero_latency, BRANCH_LOAD_DEP_ZERO_LATENCY, Flag, Flag, FALSE, )
/* On a D-cache miss, complete a feeder load at DCACHE_CYCLES (as if it hit) while
   still issuing the memory request so the line fills and MSHRs are respected. */
DEF_PARAM(branch_load_dep_hit_latency, BRANCH_LOAD_DEP_HIT_LATENCY, Flag, Flag, FALSE, )
/* On a D-cache miss, complete ALL loads at DCACHE_CYCLES (oracle upper bound). */
DEF_PARAM(perfect_dcache_hit_latency, PERFECT_DCACHE_HIT_LATENCY, Flag, Flag, FALSE, )
/* Maximum hop depth for the backward DFS from a branch to feeder loads.
   0 = unlimited (traverse the full def-use chain). */
DEF_PARAM(branch_load_dep_max_depth, BRANCH_LOAD_DEP_MAX_DEPTH, uns, uns, 0, )
/* Record branch→feeder-load pairs to a CSV for offline analysis / replay. */
/* Record branch→feeder-load pairs to CSV (proc_id,branch_inst_uid,feeder_inst_uid,depth). */
DEF_PARAM(branch_load_dep_trace_record,    BRANCH_LOAD_DEP_TRACE_RECORD,    Flag,  Flag, FALSE, )
/* Replay a recorded CSV: mark feeder loads with depth <= branch_load_dep_max_depth. */
DEF_PARAM(branch_load_dep_trace_replay,    BRANCH_LOAD_DEP_TRACE_REPLAY,    Flag,  Flag, FALSE, )
/* Directory where per-benchmark trace CSVs are written/read.
   Filename is derived automatically from CBP_TRACE_R0 as <bench>_<simpoint>.csv.
   Defaults to the current working directory (the per-simpoint output dir). */
DEF_PARAM(branch_load_dep_trace_dir,       BRANCH_LOAD_DEP_TRACE_DIR,       char*, string, ".", )
DEF_PARAM(branch_load_dep_trace_lookahead, BRANCH_LOAD_DEP_TRACE_LOOKAHEAD, uns,   uns,    100, )
/* Max allowed distance (in instructions) between feeder load and branch for replay to fire.
   Filters out deep ALU chains where the load is too far upstream. 0 = no limit. */
DEF_PARAM(branch_load_dep_trace_max_dist,  BRANCH_LOAD_DEP_TRACE_MAX_DIST,  uns,   uns,    0,   )
/* Log up to N mispredict operand-chain exemplars to bld_debug.csv in the simpoint dir. */
DEF_PARAM(bld_debug_mispred, BLD_DEBUG_MISPRED, uns, uns, 20, )
/* Profile value-slice span/hop from conditional branches (map-time, unbounded records).
   Emits BLD_PROFILE_* stats; does not record CSV or mark feeders unless also enabled. */
DEF_PARAM(branch_load_dep_profile, BRANCH_LOAD_DEP_PROFILE, Flag, Flag, FALSE, )
/* Per-PC attribution of mispredicted-branch operand-wait cycles to the critical
   load: category A = deepest outstanding miss in the branch's dataflow cone;
   category B = oldest outstanding load miss clogging the window (ROB head) when
   the cone itself has no miss. Writes branch_delay_loads.csv to the simpoint dir. */
DEF_PARAM(branch_load_dep_attribute_record, BRANCH_LOAD_DEP_ATTRIBUTE_RECORD, Flag, Flag, FALSE, )
/* Cap distinct delaying loads marked per dynamic mispredicted-branch instance in
   the attribute-record CSV/pf stream. 0 = unlimited (pre-change behavior). */
DEF_PARAM(branch_load_dep_attr_max_loads, BRANCH_LOAD_DEP_ATTR_MAX_LOADS, uns, uns, 0, )
/* Ranking used to pick the kept loads when the cap bites:
   0 = total stall cycles charged to the load; 1 = criticality tier
   (ANCESTOR before WINDOW_CLOG, then deeper cone depth). */
DEF_PARAM(branch_load_dep_attr_rank, BRANCH_LOAD_DEP_ATTR_RANK, uns, uns, 0, )
/* Address-based replay: force an L1 hit on any load whose data cacheline is in
   the recorded branch-delay set (from branch_load_dep_attribute_record), taking
   the smallest set of lines covering branch_load_dep_addr_replay_coverage of the
   recorded stall cycles. Models perfectly prefetching that data. */
DEF_PARAM(branch_load_dep_addr_replay,          BRANCH_LOAD_DEP_ADDR_REPLAY,          Flag,  Flag,  FALSE, )
DEF_PARAM(branch_load_dep_addr_replay_coverage, BRANCH_LOAD_DEP_ADDR_REPLAY_COVERAGE, float, float, 0.9,   )
/* Mark D-cache lines in the attribution replay set (branch_delay_loads coverage
   set, same file/coverage/nonfeeder knobs as branch_load_dep_addr_replay) as
   branch feeders, so the reprieve replacement policy (branch_load_dep_repl +
   branch_load_dep_repl_n) protects them. Independent of branch_load_dep_addr_replay:
   this only tags lines for retention, it does NOT force L1 hits. */
DEF_PARAM(branch_load_dep_repl_attribution,     BRANCH_LOAD_DEP_REPL_ATTRIBUTION,     Flag,  Flag,  FALSE, )
/* Measurement-only: classify every on-path demand-load access to a line in the
   attribution feeder set (br_addr_replay_hit, same trace_dir/coverage knobs) as
   cold (compulsory: first-ever access to the line), reuse-hit (line resident),
   or reuse-miss (line was seen before but was evicted -> the retention-reachable
   slice). Emits DCACHE_FEEDER_ACCESS_{TOTAL,COLD,REUSE_HIT,REUSE_MISS}. Does not
   alter replacement; run alongside baseline to characterize the feeder stream. */
DEF_PARAM(branch_load_dep_feeder_access_profile, BRANCH_LOAD_DEP_FEEDER_ACCESS_PROFILE, Flag, Flag, FALSE, )
/* Displacement counterfactual: instead of the feeder set, force-hit a count-matched
   set of NON-feeder lines drawn at random from the reused-and-evicted pool (lines
   that missed L1 >=2x, recorded as <bench>_<simpt>_nfpool.csv in the record pass).
   The set size equals the feeder replay set at branch_load_dep_addr_replay_coverage,
   so the two oracles retain an equal number of lines. Answers whether a cache line
   spent on a feeder is worth more IPC than one spent on an average reused non-feeder. */
DEF_PARAM(branch_load_dep_addr_replay_nonfeeder, BRANCH_LOAD_DEP_ADDR_REPLAY_NONFEEDER, Flag, Flag, FALSE, )
DEF_PARAM(branch_load_dep_addr_replay_seed,      BRANCH_LOAD_DEP_ADDR_REPLAY_SEED,      uns,  uns,  1,     )
DEF_PARAM(branch_load_dep_addr_replay_pool_cap,  BRANCH_LOAD_DEP_ADDR_REPLAY_POOL_CAP,  uns,  uns,  1048576, )
/* Reuse-distance study for branch-delaying loads (measurement only, does not
   alter cache replacement). For every on-path demand access it maintains a
   shadow LRU-stack analyzer and, for loads whose PC has been attributed as a
   branch-delaying load (see branch_load_dep_attribute_record), records the
   true stack (reuse) distance of the accessed line two ways: over the
   delaying-load-only reference stream (sizes a dedicated feeder cache) and
   over the full demand stream (its depth in the shared L1/L2 LRU stack).
   Writes <bench>_<simpt>_reuse.csv to the trace dir. */
DEF_PARAM(branch_load_dep_reuse_study, BRANCH_LOAD_DEP_REUSE_STUDY, Flag, Flag, FALSE, )
/* Max distinct lines tracked per shadow stack; reuses of lines aged past this
   are counted in a >cap overflow bucket. Bounds analyzer memory. */
DEF_PARAM(branch_load_dep_reuse_cap, BRANCH_LOAD_DEP_REUSE_CAP, uns, uns, 1048576, )

/* Seqnum-driven replay prefetcher. Reads the per-instance <bench>_<simpt>_pf.csv
   (seqnum,line) recorded by branch_load_dep_attribute_record and, during a normal
   timing run, issues an MRT_DPRF prefetch for each recorded line when the retire
   pointer (op_num) is within branch_load_dep_pf_lookahead of that instance's
   seqnum. Coverage is applied separately from the pf stream: the braddr.csv
   line-set (its own dir + coverage fraction) gates which lines are prefetched. */
DEF_PARAM(branch_load_dep_pf_replay,       BRANCH_LOAD_DEP_PF_REPLAY,       Flag,  Flag,   FALSE, )
/* Directory holding <bench>_<simpt>_pf.csv (the seqnum,line trigger stream). */
DEF_PARAM(branch_load_dep_pf_dir,          BRANCH_LOAD_DEP_PF_DIR,          char*, string, ".",   )
/* Directory holding <bench>_<simpt>_braddr.csv (the coverage line-set). Separate
   from pf_dir so the trigger stream and the coverage set can live apart. */
DEF_PARAM(branch_load_dep_pf_coverage_dir, BRANCH_LOAD_DEP_PF_COVERAGE_DIR, char*, string, ".",   )
/* Fraction of recorded braddr stall cycles to keep as the prefetchable line-set;
   1.0 = keep all lines = no coverage gating. */
DEF_PARAM(branch_load_dep_pf_coverage,     BRANCH_LOAD_DEP_PF_COVERAGE,     float, float,  1.0,   )
/* Lookahead W, in retire-order op_num units: prefetch fires when the retire
   pointer R satisfies seqnum <= R + W. Absolute (does not scale with ROB size). */
DEF_PARAM(branch_load_dep_pf_lookahead,    BRANCH_LOAD_DEP_PF_LOOKAHEAD,    uns,   uns,    0,     )
/* Cache level the prefetch fills into: 0 = L1D (dcache), 1 = L2 (MLC), 2 = LLC (L1). */
DEF_PARAM(branch_load_dep_pf_level,        BRANCH_LOAD_DEP_PF_LEVEL,        uns,   uns,    0,     )
/* When set, a prefetch of a target line marks that line as a branch feeder on fill,
   so the feeder-aware replacement policy (branch_load_dep_repl* / repl_rrip) retains
   it without waiting for a demand hit. */
DEF_PARAM(branch_load_dep_pf_mark_feeder,  BRANCH_LOAD_DEP_PF_MARK_FEEDER,  Flag,  Flag,   FALSE, )
/* Which cache the prefetch marks/protects feeders in: 0 = L1D (dcache), 1 = L2 (MLC).
   The corresponding cache's repl policy must be feeder-aware (dcache_repl /
   mlc_cache_repl_policy + branch_load_dep_repl* knobs). */
DEF_PARAM(branch_load_dep_pf_repl_level,    BRANCH_LOAD_DEP_PF_REPL_LEVEL,   uns,   uns,    0,     )
/* Models an unreliable prefetcher: even though it sees the whole pf.csv/coverage
   set, each prefetch opportunity (per instance) is actually issued only with this
   probability (0..1); with prob 1-rate it is dropped (not issued, not marked).
   1.0 = perfect. Isolates whether feeder retention rescues the dropped attempts on
   recurring lines. Deterministic per run via branch_load_dep_pf_success_seed. */
DEF_PARAM(branch_load_dep_pf_success_rate, BRANCH_LOAD_DEP_PF_SUCCESS_RATE, float, float, 1.0, )
DEF_PARAM(branch_load_dep_pf_success_seed, BRANCH_LOAD_DEP_PF_SUCCESS_SEED, uns,   uns,   1,   )

DEF_PARAM(dcache_hit_one_cycle, DCACHE_HIT_ONE_CYCLE, Flag, Flag, FALSE, )
