DEF_PARAM(uop_cache_insert_only_onpath, UOP_CACHE_INSERT_ONLY_ONPATH, Flag, Flag, FALSE,)
DEF_PARAM(uop_cache_read_ports, UOP_CACHE_READ_PORTS, uns, uns, 1,)
// Uop cache size in its uop capacity = UOP_CACHE_WIDTH * UOP_CACHE_LINES = 6 * 384 = 2304 uops
DEF_PARAM(  uop_cache_lines                , UOP_CACHE_LINES                 , uns    , uns     , 384                    ,       )
DEF_PARAM(  uop_cache_assoc                , UOP_CACHE_ASSOC                 , uns    , uns     , 8                      ,       )
// max uops per line should be the width of the processor
DEF_PARAM(  uop_cache_max_imm_disp_line    , UOP_CACHE_MAX_IMM_DISP_LINE     , uns    , uns     , 4                      ,       )
DEF_PARAM(  iprf_on_uop_cache_hit          , IPRF_ON_UOP_CACHE_HIT           , Flag   , Flag    , FALSE                  ,       )
DEF_PARAM(  uop_cache_repl                 , UOP_CACHE_REPL                  , uns    , uns     , 0                      ,       )
// For REPL_STICKY_PRIORITY_LINES; Likelihood of lines to be sticky when updating repl as a percent (0-100). If not sticky, default to LRU.
DEF_PARAM(priority_line_stickiness_percent, PRIORITY_LINE_STICKINESS_PERCENT, int, int, 50,)
DEF_PARAM(pw_priority_list_filepath, PW_PRIORITY_LIST_FILEPATH, char*, string, "pw_priority_list.csv", )
DEF_PARAM(num_priority_pws, NUM_PRIORITY_PWS, uns, uns, 10,)
DEF_PARAM(prioritize_pws_after_first_sticky_until_backend_stall, PRIORITIZE_PWS_AFTER_FIRST_STICKY_UNTIL_BACKEND_STALL, Flag, Flag, FALSE,)
DEF_PARAM(no_repl_after_queue_size, NO_REPL_AFTER_QUEUE_SIZE, uns, uns, 0,)

/* MLP-aware LIN replacement -- REPL_MLP (enum ordinal 9). Select it with
   --mlc_cache_repl_policy 9 (L2) or --l1_cache_repl_policy 9 (LLC).
   "A Case for MLP-Aware Cache Replacement", Qureshi/Lynch/Mutlu/Patt, ISCA'06, section 4.

   LIN evicts the line minimising  Value = Recency + lambda * Cost, where Recency is the LRU
   STACK POSITION (0 = LRU) and Cost is the quantized MLP-based cost of the miss that filled
   the line. A costly line therefore has to sink further down the stack before it is chosen,
   and lambda sets how many stack positions one cost level is worth. lambda = 0 is exactly
   true LRU, which is the control this policy must be measured against.
   REQUIRES --mlp_cost_stats 1: with the accumulator off every line carries cost 0 and the
   policy silently degenerates to LRU.

   NOT the paper's SBAR/set-dueling selector. This is static LIN only -- one fixed lambda, no
   leader sets, no PSEL. Sweep the lambda by hand first; adding dueling on top of an untested
   value function would confound two mechanisms.

   COST QUANTIZATION. The paper quantizes cost to 3 bits with 60-cycle buckets saturating at
   420, calibrated to a 400-cycle memory behind the LLC. Measured on the google traces this
   hierarchy puts 74% of demand MLC misses in costq=0 and leaves four of the eight codes
   completely unused, so the edges below are EQUAL-POPULATION cut points measured on those
   traces instead (mean MLC miss latency 215 cycles, mean cost 62). They are workload-specific:
   re-cut them from MLC_MLP_COST_* before trusting this policy on a different machine or suite,
   or scale them wholesale with --mlp_lin_cost_scale. */
DEF_PARAM(mlp_lin_lambda, MLP_LIN_LAMBDA, float, float, 1.0, )
/* Multiplies every cost quantization edge. 1.0 uses the google-derived edges verbatim; raise
   it on a machine with longer misses rather than editing the table. */
DEF_PARAM(mlp_lin_cost_scale, MLP_LIN_COST_SCALE, float, float, 1.0, )

/* --mlp_cost_edges: the seven cost quantization edges, in cycles, as a comma-separated list --
   "15,20,25,30,45,60,90". Must be exactly seven values and non-decreasing; both are asserted.
   EMPTY (the default) keeps the built-in tables measured on the google traces.

   WHY THIS IS A PARAMETER. The edges are equal-population cut points of the MEASURED cost
   distribution, so they are a property of the workload, not of the policy. Compiling them in
   meant a rebuild per suite, and there is no scaling shortcut: excluding stores moved five of
   the seven edges and moved the bottom ones DOWN while the mean went UP, so the distribution
   reshapes rather than shifts and --mlp_lin_cost_scale cannot stand in for re-cutting.

   CALIBRATING A NEW SUITE. Run a measurement config (--mlp_cost_stats 1, default replacement
   policy, so the policy does not perturb the distribution it is being calibrated from), then
   take equal-population cut points of MLC_MLP_COST_* at 5-cycle resolution, target-only
   (_count). utils/mlp_cost_edges.py does this from a collected_stats CSV.

   A SINGLE TABLE PER SUITE IS ALREADY A COMPROMISE. Across the 12 google workloads the
   per-workload edges vary 2-3x, and one (tahoe) collapses six of seven cut points onto a
   single value -- under the global table it effectively runs a 1-bit code. Check the
   per-workload spread before trusting one table for a more heterogeneous suite. */
DEF_PARAM(mlp_cost_edges, MLP_COST_EDGES, char*, string, "", )

/* SECOND COST TERM, static (no dueling), with an INDEPENDENT WEIGHT PER CLASS:
     Value = Recency + lambda*Cost + (data line ? data_lambda : instr_lambda) * Bound

   Bound is 1 when the line's boundness fraction cleared its class threshold and 0 otherwise --
   a MARK, not a graded value, because the measured fraction distribution does not support a
   graded code: on the google traces 86% of eligible MLC fills sit above 0.65 and an 8-level
   equal-population quantization yields only 6 distinct cut points. Since Bound is binary, each
   lambda is a FLAT BONUS IN LRU STACK POSITIONS, not a multiplier on a range -- unlike
   --mlp_lin_lambda, which scales a 0..7 cost level. The two scales are NOT comparable: at
   16-way, data_lambda 8 is half the stack while mlp_lin_lambda 8 would be eight times it.

   Separate weights per class because the classes carry DIFFERENT SIGNALS measured on different
   populations -- a data line's membound fraction comes from its demanding load's dispatch->done
   window, an instruction line's front-end-bound fraction from the fetch stall its miss caused --
   and nothing says one stack position of protection is worth the same to both. They are
   mutually exclusive per line (Cache_Entry.membound_fill vs fe_bound_fill), so exactly one
   weight ever applies to a given line. Each keeps its own threshold, mirroring
   TD_LOAD_REPLAY_THRESH / TD_FE_RRIP_THRESH.

   Both default to 0, i.e. the term is off and the policy is plain LIN until asked otherwise.

   MEASUREMENT IS SELF-OPENING. A nonzero instr_lambda adds MLP_LIN_INSTR_LAMBDA to the
   front-end window gate in topdown.c, so the policy turns on its own signal instead of
   borrowing --td_fe_rrip_mark, which would apply REPL_MARKED_RRIP to the L1I and confound a
   policy experiment with an unrelated L1I policy change. Likewise a nonzero lambda of either
   kind makes membound_classify_fill run even with --membound_stats 0, so the term cannot
   silently no-op because a stats knob was left off. */
DEF_PARAM(mlp_lin_data_lambda, MLP_LIN_DATA_LAMBDA, float, float, 0.0, )
DEF_PARAM(mlp_lin_instr_lambda, MLP_LIN_INSTR_LAMBDA, float, float, 0.0, )

/* --mlp_lin_pref_lambda: PENALTY, in LRU stack positions, for a line installed by a prefetch.
   The exact mirror of the boundness bonus -- same units, opposite sign -- so a prefetched line
   is pushed DOWN the value ordering and evicted early, where a membound line is pushed up.

   WHY IT EXISTS. Prefetch fills carry no demanding load, so they already score cost 0 and mark
   0 under LIN and are evicted first by accident. Measured on the google traces that accident
   appears to be carrying most of LIN's benefit: prefetch share of MLC fills correlates +0.880
   with LIN's IPC gain over LRU, while average MLP correlates -0.083. This knob makes the effect
   EXPLICIT and separable, so it can be run WITHOUT the cost model:

     --mlp_lin_lambda 0 --mlp_lin_data_lambda 0 --mlp_lin_instr_lambda 0 --mlp_lin_pref_lambda 14

   is plain LRU plus prefetch deprioritisation and nothing else. If that captures most of the
   +2.68% mean gain, then LIN's measured benefit here is prefetch handling rather than
   MLP-awareness, and the cost machinery is along for the ride.

   ON THESE TRACES A PREFETCH IS AN FDIP INSTRUCTION PREFETCH. PARAMS.google runs no data
   prefetcher (--pref_framework_on 0, --pref_stream_on 0) and FDIP_ENABLE defaults on, while
   demand ifetch is only 1.5% of MLC misses -- so instruction lines reach the L2 almost entirely
   as FDIP prefetch. Deprioritising them is therefore an instruction-vs-data CAPACITY
   PARTITIONING knob on this machine, whatever it would mean elsewhere.

   At 16-way, 14 puts a prefetched line below nearly every non-prefetched one regardless of
   recency. 0 (the default) disables the term. */
DEF_PARAM(mlp_lin_pref_lambda, MLP_LIN_PREF_LAMBDA, float, float, 0.0, )

/* --mlp_lin_store_lambda: PENALTY, in LRU stack positions, for a line carrying WRITE traffic.
   Same shape as the prefetch penalty -- subtracted, so the line sinks rather than floats.

   SET ASSOC (16 at this geometry) TO PARTITION CLEANLY. Recency spans 0..assoc-1, so a penalty
   of assoc puts every written line strictly below every unwritten one while leaving BOTH GROUPS
   IN LRU ORDER INTERNALLY -- subtracting a constant is order-preserving. Smaller values let the
   groups overlap so recency and cost can still rank across the boundary; larger ones buy
   nothing beyond assoc.

   WHY WRITES. Stores are 28.7% of MLC demand misses and already sit awkwardly in this policy:
   they accrue MLP cost (they occupy MSHRs like loads) but can never be marked membound, because
   the membound fraction is a load-window measurement. A written line is also the one whose
   eviction costs a writeback. This makes the treatment explicit instead of leaving it implicit.

   WHAT COUNTS AS WRITTEN. The fill was a store miss (MRT_DSTORE) or a writeback (MRT_WB), or a
   writeback later hit the resident line -- which is how an MLC line actually becomes dirty
   here, the L1D absorbing stores and writing back. NOT Cache_Entry.dirty, which is documented
   "used only in warmup now" and is never maintained for the MLC.

   0 (the default) disables the term. Applies to REPL_MLP (policy 9) only; REPL_MLP_PAPER
   (policy 23) is the published policy and carries no extra terms by design. */
DEF_PARAM(mlp_lin_store_lambda, MLP_LIN_STORE_LAMBDA, float, float, 0.0, )

/* --mlp_lin_offpath_lambda: PENALTY, in LRU stack positions, for a line installed by a
   WRONG-PATH request. Same shape as the prefetch and store penalties -- subtracted, so the
   line sinks, and set assoc (16 here) to partition cleanly while leaving both groups in LRU
   order internally.

   DISTINCT FROM THE OFF-PATH COST KNOBS. --mlp_cost_include_offpath and
   --mlp_paper_confirm_offpath decide whether a wrong-path miss ACCRUES COST; excluding it
   leaves the line at cost 0, which is the FLOOR, not a penalty. Such a line still carries full
   recency and sits at MRU when freshly filled, so it is the LAST thing evicted in its set. This
   knob is what actively demotes it. The prefetch case showed the distinction matters: an
   explicit penalty measured differently from the implicit cost-0 treatment.

   WHY IT IS WORTH HAVING. Scarab never squashes an off-path request -- recover_memory() only
   stamps a flag -- so a wrong-path miss completes, consumes bandwidth, and fills the cache.
   Those lines are real occupants competing for capacity, and 39% of MLC misses are off-path.

   THE FLAG IS CLEARED ON VINDICATION. The first ON-PATH DEMAND hit on the line drops it: a real
   access needed the line, so the speculative-garbage assumption is falsified and penalising it
   further would demote exactly the wrong-path fills that turned out useful -- which is real
   here, since Scarab never squashes an off-path request. Demand only; a prefetch hit is itself
   speculative and proves nothing. Hence the field is offpath_unproven, not fill_was_offpath.

   Uses the ORACLE req->off_path, matching L1_Data.fetched_by_offpath. A confirm-and-retract
   version is not possible at fill time: a miss whose branch has not resolved is not yet known
   to be off-path, so it would have to be set after the fact the way cache_mark_written does.

   0 (the default) disables the term. Applies to REPL_MLP (policy 9) only; REPL_MLP_PAPER
   (policy 23) is the published policy and carries no extra terms by design. */
DEF_PARAM(mlp_lin_offpath_lambda, MLP_LIN_OFFPATH_LAMBDA, float, float, 0.0, )

/* --mlp_lin_bound_signal: which per-load stall signal REPL_MLP's boundness term consumes.
   Values are the Bound_Signal enum in memory.h:
     0  MEMBOUND  td_mem_cycles / td_window_cycles  -- backend_stall && loads in flight. DEFAULT,
                  and identical to every run made before this knob existed, so 0 reproduces them.
     1  FU0       td_fu0_cycles / td_window_cycles  -- no FU doing non-memory work && loads in
                  flight. Measured at the execution units rather than inferred from back-pressure
                  at the IDQ->rename boundary, so it does not fire on register-file exhaustion.
     2  FU_WAIT   td_fu_wait_cycles / td_window_cycles -- no FU executing && at least one op
                  waiting on operands. A dependence stall stated directly.

   WHAT IT CHANGES. Only the fraction the POLICY consumes: the value staged onto the filled line
   (Cache_Entry.bound_frac) and the mark derived from it (membound_fill, gated by the same
   --td_load_replay_thresh). mlp_lin_bound_term then thresholds that as before, so
   --mlp_lin_data_lambda / --mlp_lin_instr_lambda keep their meaning.

   WHAT IT DOES NOT CHANGE. The measurement chains. MLC_MEMBOUND_FRAC_*, MLC_FU0_FRAC_* and
   MLC_FU_WAIT_FRAC_* are emitted from the three fractions directly and are unaffected by this
   knob, so every arm of a sweep reports the same three histograms and stays comparable. It also
   does not touch the FE-bound path: an instruction fill has no load window, so MRT_IFETCH keeps
   using the front-end fraction whatever this is set to.

   MEASURED per-load at fill on the google traces (all three over the same 24.4M fills):
   mark rate above the 0.5 gate is 86.1% / 87.9% / 82.5% for MEMBOUND / FU0 / FU_WAIT, so the
   threshold decision is far less sensitive to the choice than the 17.75% per-CYCLE disagreement
   between the proxies suggests. Expect small policy deltas and size the sweep accordingly. */
DEF_PARAM(mlp_lin_bound_signal, MLP_LIN_BOUND_SIGNAL, uns, uns, 0, )

/* --mlp_lin_instr_no_commit: tighten the per-cycle condition behind REPL_MLP's INSTRUCTION-side
   boundness fraction. The instruction-side analogue of --mlp_lin_bound_signal: it swaps the
   NUMERATOR of the fraction the policy consumes and changes nothing else.

     0 (DEFAULT)  fe_bound / window      -- the issue queue is empty (idq_sd.op_count == 0,
                  i.e. the front end delivered nothing to rename). Identical to every run made
                  before this knob existed, so 0 reproduces them.
     1            fe_commit / window     -- the issue queue is empty AND retirement committed
                  nothing this cycle. Same window, so the two fractions share a denominator and
                  fe_commit <= fe_bound always holds.

   WHY. An empty issue queue says fetch starved; it does NOT say the machine stalled. With a
   352-entry ROB the back end can retire work fetched long before the current icache miss, and
   those cycles cost nothing in IPC. Counting them inflates the fraction of exactly the misses
   that were successfully overlapped -- the ones a capacity-limited L2 should be LEAST eager to
   protect -- so at 1 the fraction counts only cycles where the awaited miss actually stopped
   retirement. Cycle-level, hence a numerator and not a second threshold: a fill's mark would
   otherwise still be derived from cycles the machine was making progress through.

   COMMITTED MEANS ANY UOP. node_retired_this_cycle() is true if node_retire committed at least
   one op, not one eom instruction, so a cycle draining the tail uops of a multi-uop instruction
   counts as progress and is excluded from the numerator. Strictly stronger than the
   architectural reading, and it is the reading that matches "the machine made no progress".

   WHAT IT DOES NOT TOUCH. (a) The DATA side -- an instruction fill has no load window, so this
   and --mlp_lin_bound_signal are disjoint by construction, exactly as that knob's note says.
   (b) The FE-bound MEASUREMENT chains: *bound_frac keeps the fe_bound numerator whatever this
   is set to, so MLC_FEBOUND_* and the reuse-distance histograms stay comparable across a sweep.
   (c) td_fe_rrip_mark / td_fe_rrip_on_mlc / td_combined_*, which keep reading fe_bound/window:
   the two numerators are accumulated side by side over one window in Icache_Stage, so no other
   policy's signal moves. The MARK (Cache_Entry.fe_bound_fill) does follow the selected
   fraction, mirroring the data side, where the mark likewise comes from the selected signal.

   NEEDS --mlp_lin_instr_lambda to do anything: with that at 0 the boundness term is off and
   this only relabels a mark nothing weighs. Applies to REPL_MLP (policy 9) only. */
DEF_PARAM(mlp_lin_instr_no_commit, MLP_LIN_INSTR_NO_COMMIT, Flag, Flag, FALSE, )

/* --mlp_lin_instr_include_offpath: make EVERY awaited demand instruction fetch eligible for
   REPL_MLP's instruction-side priority, not just on-path ones.

     0 (DEFAULT)  the fraction is reported only while the blocked fetch stream is on path, so an
                  instruction fill behind a wrong-path fetch gets no fraction, no mark and no
                  bonus -- it scores like a prefetch or a writeback. Identical to every run made
                  before this knob existed.
     1            the path gate is dropped. The awaited-line match, the window and the threshold
                  are unchanged, so such a fill is marked on exactly the same evidence an on-path
                  one is: the stall its own miss caused.

   WHY. Scarab never squashes an off-path request, and the front end really is stalled on it:
   fetch is in-order, so while the L1I waits on a wrong-path line NOTHING is fetched, on-path or
   not, and those cycles land in the window either way. The resulting line is also a real
   occupant of the L2 competing for capacity -- 39% of MLC misses are off-path here -- and on
   these traces instruction lines reach the L2 almost entirely as FDIP prefetch, so demand
   ifetch is the thin slice the gate was quietly halving. Excluding them means the policy ranks
   a measured stall as worth nothing merely because the branch above it resolved wrong.

   THE OTHER READING, which is why this is a knob and not a fix: a wrong-path line's stall cost
   is REAL but its future VALUE is not implied by it. Protecting it spends capacity on a line
   the machine may never ask for again. Compare arms before believing either story.

   INTERACTS WITH --mlp_lin_offpath_lambda, deliberately and without special-casing. At 1 an
   off-path instruction fill can now take the boundness BONUS while that knob subtracts its
   off-path PENALTY; the two are separate terms of one sum, so the net is whatever the lambdas
   say. Running both is a legitimate arm (is the stall worth more than the speculation risk?)
   but not a control -- set one at a time to attribute an effect.

   WIDENS THE FEBOUND MEASUREMENT POPULATION TOO, unlike --mlp_lin_instr_no_commit, which only
   swaps a numerator. Eligibility IS the gate on reporting a fraction at all, so at 1 the
   MLC_FEBOUND_* chains and the reuse-distance split count these fills as well. That is the
   intent rather than a side effect: the histograms then describe the population the policy
   acts on, and a run whose stats omitted the lines it was protecting could not be read.

   Applies to REPL_MLP (policy 9) only -- td_fe_rrip_mark, td_fe_rrip_on_mlc and td_combined_*
   keep their own on-path gate. (The L1I variant is already path-agnostic by its own design, for
   the reason above: it inserts the line the awaited miss returned, as hardware does.) */
DEF_PARAM(mlp_lin_instr_include_offpath, MLP_LIN_INSTR_INCLUDE_OFFPATH, Flag, Flag, FALSE, )

/* --mlp_lin_instr_merge_lead_gate: restrict --mlp_lin_instr_include_pref_merge to merges whose
 * prefetch had a SHORT lead time.
 *
 * Without this, every instruction prefetch a demand merged into is eligible for the FE-bound
 * mark, whatever the prefetch's head start. The argument for narrowing it: the lead time is how
 * long the prefetch had already been in flight when the demand caught it, so a LONG lead means
 * the prefetch was nearly done and the stall the demand actually paid was short. Marking those
 * spends protection on lines whose miss cost was already mostly hidden. A short lead is the case
 * where the prefetch bought little and the front end paid close to a full service latency.
 *
 * The measured quantity is Mem_Req.instr_merge_delta, captured at the FIRST demand ifetch merge
 * and maintained unconditionally by mem_req_match_reqbuf, so this needs no other arm enabled.
 * The test is STRICTLY LESS THAN --mlp_lin_instr_merge_edge; a delta of 0 (demand arrived in the
 * same cycle the prefetch was emitted) is the shortest possible lead and is always included.
 *
 * DEMAND fills are untouched. req->type == MRT_IFETCH has no lead time -- no prefetch ran ahead
 * of it -- and gating it on one would silently drop the entire demand-instruction population.
 *
 * DEFAULTS OFF, so --mlp_lin_instr_include_pref_merge keeps the behaviour every earlier run was
 * measured with and those results stay reproducible from the same flags. Turn it on to get the
 * narrowed rule. MLC_FEBOUND_MERGE_LONG_LEAD counts what the gate rejects, so its effect is
 * visible without a second run. */
/* --mlp_lin_merge_lambda: a SEPARATE boundness weight for marked MERGES, distinct from the one
 * marked demand instruction fills get.
 *
 * REPL_MLP's instruction term is one lambda applied to every FE-bound-marked line. But the two
 * populations it marks are different events: a demand instruction fetch that missed and stalled
 * the front end for the full service latency, and an instruction prefetch a demand caught in
 * flight, which hid some of that latency before the stall began. Weighting them identically
 * asserts they are worth the same, which is an assumption rather than a measurement -- and on
 * these traces the merge half is ~77% of the marked population, so it is the assumption that
 * actually sets the policy's behaviour.
 *
 * WHICH LINES IT APPLIES TO: a marked line whose fill came from a prefetch. No new per-line bit
 * is needed, because fe_bound_fill can only be set two ways -- req->type == MRT_IFETCH, which is
 * never a prefetch, or a merged instruction prefetch, which always is -- so the existing
 * Cache_Entry.fill_was_prefetch separates them exactly. The same discriminator REPL_SRRIP_FE
 * uses for its marked-demand / marked-merge split.
 *
 * THE THRESHOLD IS UNCHANGED. A merge still has to clear --mlp_lin_instr_thresh to be marked at
 * all; this only changes what a marked merge is WORTH.
 *
 * -1 MEANS INHERIT --mlp_lin_instr_lambda, which is the default and reproduces the single-lambda
 * behaviour every earlier run was measured with, so those results stay reproducible from the same
 * flags. Any value >= 0 takes effect. 0 is meaningful and distinct from the default: it marks
 * merges (they still count in MLC_FEBOUND_FILL) while giving them no protection at all, which is
 * the clean way to ask whether the demand half alone carries the policy.
 *
 * DISABLES THE --load_prio_stats LEVEL HALF when it differs from the instruction lambda, exactly
 * as a placement lambda does: the level table enumerates the boost over a THREE-valued boundness
 * term (none / data / instruction), and a fourth value takes the 8x3 grid to 8x4 = 32 reachable
 * boosts against a 24-entry table and 24-wide stat chains. Composition and the per-class chains
 * are unaffected; a WARNINGU at init says so. */
DEF_PARAM(mlp_lin_merge_lambda, MLP_LIN_MERGE_LAMBDA, float, float, -1.0, )

DEF_PARAM(mlp_lin_instr_merge_lead_gate, MLP_LIN_INSTR_MERGE_LEAD_GATE, Flag, Flag, FALSE, )
/* The edge, in cycles. 0 means "track L1_CYCLES", i.e. the LLC access latency -- the same
   convention and the same default as --ifetch_xtion_merge_edge and --srrip_t_merge_edge, so all
   three bucket a merge identically unless deliberately pinned apart. Inert unless the gate
   above is on. */
DEF_PARAM(mlp_lin_instr_merge_edge, MLP_LIN_INSTR_MERGE_EDGE, uns, uns, 0, )

/* --mlp_lin_instr_include_pref_merge: let a LATE instruction prefetch earn REPL_MLP's
   instruction-side priority -- an FDIP prefetch still in flight when the demand fetch for the
   same line arrives and merges into it.

     0 (DEFAULT)  only a fill whose req->type is MRT_IFETCH is classified as an instruction
                  fill. A prefetch-created request keeps its prefetch type through an ifetch
                  merge, so such a fill takes the DATA branch, finds no demanding load, and
                  scores no fraction, no mark and no bonus. Reproduces earlier runs.
     1            a prefetch-typed fill with the MRT_IFETCH bit in req->types is classified as
                  an instruction fill as well, and is then marked on the same evidence and
                  against the same threshold as a demand fetch: the stall of the icache miss
                  the front end is blocked on.

   WHY IT MATTERS MORE HERE THAN THE NAME SUGGESTS. On PARAMS.google, instruction lines reach
   the L2 almost entirely as FDIP prefetch and demand ifetch is only 1.5% of MLC misses, so at 0
   the instruction-side term is scoped to that 1.5% -- and the fills it is MOST meant to protect
   are exactly the ones it cannot see. A merged prefetch is by construction a prefetch that
   arrived too late to hide anything: fetch is in-order, so the front end is stopped on that
   line right now. It is the MLC_PREF_LATE / L1_PREF_LATE population.

   ELIGIBILITY IS NOT A MARK. Classification only lets the fill ask; the icache's awaited-miss
   window still has to answer, so a TIMELY prefetch -- filled before any demand fetch wanted it,
   which is the common case and the one that cost nothing -- reports nothing and stays unmarked.
   Nothing here marks a line because it was prefetched; the signal is still a measured stall.

   THE WINDOW IS THE STALL, NOT THE PREFETCH LATENCY. icache_tag_inflight_miss resets its
   counters when the DEMAND fetch is issued (the merge returns success, so the icache takes the
   ICACHE_WAIT_FOR_MISS path exactly as for a fresh miss), so the denominator runs from the
   demand request to the fill and excludes however long the prefetch was already in flight.
   That is the quantity wanted -- the cycles the front end was stopped on this line -- and it
   makes the fraction directly comparable with a demand miss's. A fill that lands in the same
   cycle the demand was issued leaves a zero-length window and so reports nothing, which is the
   same edge the demand path has.

   INTERACTS WITH --mlp_lin_pref_lambda, and the two pull opposite ways on the SAME fill: the
   line is still prefetch-installed (cache_set_next_fill_prefetch reads req->type, which the
   merge leaves alone), so at 1 a late FDIP prefetch can take the instruction bonus AND the
   prefetch penalty, netting to whatever the lambdas say. That is worth knowing before reading a
   sweep, because on these traces the prefetch penalty is the term carrying most of LIN's
   measured benefit. If the intent is "demand-merged prefetches are not speculative any more",
   that is a change to the PREFETCH flag, not to this knob, and it does not exist yet.

   WIDENS THE FEBOUND MEASUREMENT POPULATION, like --mlp_lin_instr_include_offpath and for the
   same reason: eligibility gates whether a fraction is reported at all, so at 1 the
   MLC_FEBOUND_* chains and the reuse-distance split take in these fills too. Deliberate -- the
   histograms should describe the population the policy acts on -- but it means FEBOUND counts
   are not comparable between a 0 and a 1 arm.

   Applies to REPL_MLP (policy 9) only. td_fe_rrip_on_mlc and td_combined_* keep testing
   req->type == MRT_IFETCH in their own fill paths and are untouched. */
DEF_PARAM(mlp_lin_instr_include_pref_merge, MLP_LIN_INSTR_INCLUDE_PREF_MERGE, Flag, Flag, FALSE, )

/* ============ REPL_MLP ADAPTIVE LAMBDAS (--mlp_lin_dyn_instr / --mlp_lin_dyn_data) ============
   A CLOSED LOOP on the two boundness lambdas. Every window of 2^N retired instructions, each
   lambda is nudged by one step according to whether its own signal got WORSE or BETTER than the
   window before:

     instruction lambda  <- branch mispredictions per window    (fetch is hurting -> protect
                                                                 instruction lines harder)
     data lambda         <- FU_WAIT share of the window's cycles (the machine is dependence-
                                                                 stalled more -> protect data)

   TWO REGISTERS PER SIGNAL, previous window and current window, which is the whole state: the
   rule is relative, so nothing older than one window can influence it. Mispredictions are read
   as a delta of the always-charged BP_L0_MISPRED + BP_MAIN_MISPRED counters (no knob to
   remember, and the same numerator as the MPKI these runs are reported with -- note it includes
   WRONG-PATH branches, since those counters carry no off-path guard). FU_WAIT is accumulated
   here from the per-cycle signal itself, NOT from MEMPROXY_FU0_WAIT, which only exists under
   --memproxy_stats: a policy that silently became a no-op because a stats knob was off is the
   failure this codebase keeps designing out.

   THE THREE SHAPE KNOBS, all with defaults that reproduce the rule as first specified:
   --mlp_lin_dyn_window_log2 (window = 2^N retired instructions, default 20 = 1,048,576),
   --mlp_lin_dyn_thresh (the band, default 0.05 = the 5% rule) and --mlp_lin_dyn_step (how far
   one step moves a lambda, default 1.0).

   WHY THE WINDOW IS IN INSTRUCTIONS AND A POWER OF TWO. Equal-instruction windows make two
   consecutive mispredict COUNTS directly comparable -- they are already per-instruction rates
   with the same denominator -- so the branch rule needs no division. A power of two makes the
   boundary a bit flip in the retired-instruction count: the window closes on the cycle where
   inst_count >> N changes, costing a shift and a compare per cycle. 20 is 1,048,576
   instructions, the "1M" window.

   THE DATA SIDE CANNOT USE A RAW COUNT for the same reason the branch side can: the windows are
   equal in instructions, not cycles, so a window with worse IPC contains more cycles and more
   FU_WAIT cycles at an unchanged stall fraction. It therefore compares
   fu_wait_cycles/window_cycles, and keeps the extra register pair that requires.

   FIRST WINDOW NEVER ADJUSTS -- there is no previous window to compare against -- and neither
   does a window whose predecessor measured zero, since a relative threshold on zero is
   meaningless. Both are counted as HOLD in the stats so the arm's activity is auditable.

   MUTUALLY EXCLUSIVE WITH --load_prio_stats, enforced at init rather than left to be
   discovered. That instrumentation builds an EXACT-MATCH table of the boosts reachable from the
   static lambdas and looks a fill's boost up in it; the first fill after any adjustment would
   find a boost that is not in the table and abort. See load_prio_levels_init.

   SINGLE CORE ONLY, also asserted: the lambdas are global to the policy while the signals are
   per-core, so two cores would fight over one pair of registers.

   WHERE IT STARTS: --mlp_lin_instr_lambda and --mlp_lin_data_lambda, the ordinary static
   lambdas, which an enabled side takes as its OPENING VALUE and then moves. There is
   deliberately no separate pair of "start" knobs: a dynamic descriptor names its lambdas exactly
   as a static one does, so an arm and its own static control differ by one flag and nothing
   else. The pair is seeded once, on first read, in cache_lib; a DISABLED side simply keeps
   reading its static param and never consults the register.

   SELF-OPENING, and this one matters more than usual. Those same static lambdas are what open
   the MEASUREMENT -- the fill classification in membound_classify_fill, the FE-bound window in
   topdown_idq_update, and its per-miss reset in icache_stage.c all test them for != 0 -- so the
   toggles are in those gates too, each where it belongs: the instruction-side gates take
   --mlp_lin_dyn_instr, and the gates that serve either side take both. That matters even though
   a side starts from its static lambda, because starting at 0 and letting it walk UP is a
   legitimate arm: without the toggle in those gates, such a run would classify nothing, mark
   nothing, and walk a lambda that weighed an empty term, reading as "the policy does nothing"
   rather than as a missing input. */
/* ONE TOGGLE PER SIDE, independent. Each says only "does THIS lambda move"; the side that is
   off keeps its static --mlp_lin_*_lambda value for the whole run, exactly as if the arm did not
   exist. The four combinations are the experiment:

     0 0   the static policy -- the control for any of the others
     1 0   instruction lambda tracks branch mispredictions, data lambda pinned
     0 1   data lambda tracks the FU_WAIT share, instruction lambda pinned
     1 1   both loops closed

   Worth having as two knobs rather than one because the loops are not symmetric and do not have
   to be judged together: the instruction side can only help where the front end is the limit,
   while the data side is the one competing with it for the same ways. Running them one at a time
   is what attributes a result to a loop; running both and comparing to a 0 0 control cannot. */
DEF_PARAM(mlp_lin_dyn_instr, MLP_LIN_DYN_INSTR, Flag, Flag, FALSE, )
DEF_PARAM(mlp_lin_dyn_data, MLP_LIN_DYN_DATA, Flag, Flag, FALSE, )

/* Window size, as a LOG2 of retired instructions. 20 = 1,048,576. Range-checked at first use. */
DEF_PARAM(mlp_lin_dyn_window_log2, MLP_LIN_DYN_WINDOW_LOG2, uns, uns, 20, )

/* Relative change that triggers a step, applied symmetrically: a signal above (1+t)x its
   previous window steps its lambda UP, below (1-t)x steps it DOWN, and anything between holds.
   0.05 is the 5% rule. A band, not a single threshold, so a signal hovering at the boundary
   does not oscillate every window. */
DEF_PARAM(mlp_lin_dyn_thresh, MLP_LIN_DYN_THRESH, float, float, 0.05, )

/* How much one step moves a lambda, in LRU stack positions. 1.0 is "increase by one". */
DEF_PARAM(mlp_lin_dyn_step, MLP_LIN_DYN_STEP, float, float, 1.0, )

/* Clamps on the walk. The floor is 0 and not negative on purpose: a negative lambda inverts the
   policy -- a "boost" that evicts the lines it is supposed to protect -- which cache_lib refuses
   for the static params too. The ceiling stops an unbounded drift over a long run; at assoc 16
   anything past ~16 already outranks recency entirely, so 64 is slack, not a target. */
/* ================== --instr_upfill: demote instruction victims one level out ==================
   An instruction line evicted from the L1I is installed into the MLC, and one evicted from the
   MLC into the LLC, unless it is already there. Scarab otherwise drops instruction victims
   silently -- they are clean, so there is no writeback -- which means the last copy leaving a
   level takes the line off the chip entirely.

   STANDS ALONE. This is a placement change, not a policy: it works under REPL_TRUE_LRU exactly as
   under REPL_MLP, and is not gated on --mlc_cache_repl_policy 9 or on --fdip_delta_place, so its
   effect can be measured by itself. The two lambdas below are read only by REPL_MLP's value
   function; under any other policy a demoted line just takes its ordinary place in recency order.

   BEST EFFORT. A demotion that would displace a DIRTY line is skipped, because making room would
   need a writeback request that can fail, and an eviction cannot be retried the way a fill can.
   Skipping is always safe -- dropping a clean instruction line is today's behaviour.

   A DEMOTED LINE IS NOT A FILLED LINE, and carries its own class so the two are separable: it was
   evicted once and has not been asked for since, so by default it gets no protection at all
   (--instr_upfill_lambda 0) and competes on recency. If an instruction prefetch later HITS it, it
   has been asked for, and is promoted to --instr_upfill_promote_lambda. That promotion is the
   feedback the lead-time rule never had: evidence about the line rather than about one fill. */
DEF_PARAM(instr_upfill, INSTR_UPFILL, Flag, Flag, FALSE, )

/* --instr_upfill_pref_l1i_only: an instruction PREFETCH fills the L1I and NOTHING else; the MLC
   and the LLC both decline it. Prefetched lines then enter the shared hierarchy only by
   demotion, which is what makes a line's LEVEL mean "how recently was it useful" rather than
   "how recently was it speculated about". A fill-on-miss hierarchy cannot express that: a
   prefetch plants a copy at every level before anything has used the line once.

   APPLIES TO EVERY INSTRUCTION PREFETCH, merged or not. Whether a demand was waiting is a fact
   about one access, not about how long the line stays useful -- so a late prefetch takes the
   same route as a timely one, in via the L1I and outward by demotion.

   DEMAND-CREATED fetches are unaffected and fill normally. Those are the lines FDIP failed to
   predict at all, and they are only ~1.5% of MLC instruction traffic on these traces.

   Requires --instr_upfill (asserted at init). Without the demotion path this would strand every
   speculative line in the L1I alone, and each L1I eviction would become a trip to memory. */
DEF_PARAM(instr_upfill_pref_l1i_only, INSTR_UPFILL_PREF_L1I_ONLY, Flag, Flag, FALSE, )

/* --instr_upfill_demand_l1i_only: the same rule for a DEMAND instruction fetch -- it fills the
   L1I and nothing else. With --instr_upfill_pref_l1i_only this completes the hierarchy: no
   instruction line enters the MLC or the LLC by a fill at all, and demotion is the only way in,
   so a line's level is purely how long ago the L1I stopped wanting it.

   Its own knob because the populations are nothing alike -- demand instruction fills are ~0.5%
   of MLC insertions against ~71% for demotions -- and because these are exactly the lines FDIP
   could not predict. Declining them removes the last direct route for the one population that
   has no prefetch behind it, which may well be the wrong trade; it is worth being able to turn
   off independently.

   Note it also removes the direct application of --instr_nopref_lambda, since that class is
   applied at a fill. The class still reaches the MLC, but only carried outward by the demotion,
   so MLC_NO_PREFETCH_FILL goes to zero while the marking keeps working. Requires
   --instr_upfill. */
DEF_PARAM(instr_upfill_demand_l1i_only, INSTR_UPFILL_DEMAND_L1I_ONLY, Flag, Flag, FALSE, )

/* --instr_nopref_lambda: boost, in LRU stack positions, for a line FDIP NEVER PREFETCHED.

   The icache classifies every demand miss: a prefetch still in flight (timeliness failure), a
   prefetch that arrived and was evicted too early (capacity failure), or no prefetch at all
   (IMISS_NOT_PREFETCHED -- a PREDICTION failure). Only the last says the prefetcher could not
   produce the line, and those misses are the ones no amount of prefetch tuning will remove: the
   front end pays the full latency every time, with nothing hiding it.

   That makes them the lines most worth keeping close. Everything else in this file protects
   lines by where they came from or how long they stayed wanted; this protects them by the
   prefetcher's demonstrated inability to cover them.

   ON-PATH ONLY -- an off-path miss is not a failure to predict, it is a path that should not
   have been fetched. REPL_MLP only, like the other lambdas, and 0 (the default) means the class
   is never even applied, so a run without it is bit-identical to one built without the term. */
DEF_PARAM(instr_nopref_lambda, INSTR_NOPREF_LAMBDA, float, float, 0.0, )

/* --instr_latepref_lambda: boost for a line whose prefetch was UNTIMELY -- issued, but still in
   flight when the demand arrived. The companion to --instr_nopref_lambda, and the other half of
   the icache's miss classification: that one is a PREDICTION failure, this is a TIMELINESS one.

   Both stalled the front end, so both are worth keeping close, but they are separate lambdas
   because the populations differ by an order of magnitude on these traces (late prefetches are
   ~1.7 icache misses per 1K instructions against ~0.3 never-prefetched) and because the remedies
   differ: a late prefetch becomes timely if the line is simply nearer next time, while a line
   FDIP cannot predict will cost full latency however close it is kept.

   Detected at the fill as "prefetch-created request carrying the MRT_IFETCH bit" -- a demand
   merged into it, which is exactly what being caught in flight means. Mutually exclusive with
   the no-prefetch class. Carried outward by --instr_upfill demotions, which matters because
   --instr_upfill_pref_l1i_only declines these fills at the MLC: the class is applied at the L1I
   and travels out with the line. REPL_MLP only; 0 (the default) never applies the class. */
DEF_PARAM(instr_latepref_lambda, INSTR_LATEPREF_LAMBDA, float, float, 0.0, )

/* --instr_upfill_carry_on_hit: when a hit at the MLC or LLC releases a line up to the L1I, the
   line's CLASS travels with it instead of dying with the copy.

   Without this, --instr_upfill_hit_invalidate makes every mark one-shot: a line classed
   NO_PREF or LATE_PREF is released the first time anything touches it, cache_invalidate clears
   delta_prio with the rest of the entry, and when the line is demoted back it returns as a plain
   demoted line. A boost can therefore protect a line only until it is next used -- which is
   precisely when the line has proved itself, so the protection is cancelled by its own success.

   With this on, the class is read off the serving level before the release, parked on the
   request, and staged onto the L1I fill; the next demotion carries it back out. The line is
   STILL released, so exclusivity is unchanged -- only the fact about the line survives the trip.

   DELTA_PRIO_UPFILL is not carried: "was demoted once" is a property of a demotion and is
   re-derived at the next one anyway. Only the earned classes travel.

   Requires --instr_upfill. Does nothing without --instr_upfill_hit_invalidate, since without a
   release there is no copy being destroyed and the MLC line keeps its class directly. */
DEF_PARAM(instr_upfill_carry_on_hit, INSTR_UPFILL_CARRY_ON_HIT, Flag, Flag, FALSE, )

/* --instr_upfill_hit_invalidate: when an instruction request HITS in the MLC or the LLC and the
   line is delivered to the L1I, that level RELEASES its copy.

   The line moved up. Under an exclusive hierarchy it should exist at exactly one level, and a
   copy left behind holds a way for a line that is resident closer to the core and cannot be
   needed from here until the L1I evicts it -- at which point the demotion path puts it back.
   Without this, a prefetch hit leaves a duplicate AND (under --instr_upfill_promote_lambda)
   pins it, which spends MLC capacity on lines the icache already has.

   This is the other half of --instr_upfill_pref_l1i_only. That flag stops a line entering the
   outer levels on the way IN; this one stops it lingering there on the way BACK UP. Together the
   level a line occupies is exactly "how long ago the L1I stopped wanting it".

   Supersedes --instr_upfill_promote_lambda: with the copy released there is nothing left to
   promote, so the promotion is skipped rather than applied to a line about to disappear.

   Releases only on CONFIRMED delivery (the hit access returned TRUE; a retry would otherwise ask
   for a line that had just been destroyed) and never a dirty line. Requires --instr_upfill. */
DEF_PARAM(instr_upfill_hit_invalidate, INSTR_UPFILL_HIT_INVALIDATE, Flag, Flag, FALSE, )

/* Boost for a demoted line, in LRU stack positions. 0 (the default) is the honest starting point:
   a line that was just evicted has no claim on protection. REPL_MLP only. */
DEF_PARAM(instr_upfill_lambda, INSTR_UPFILL_LAMBDA, float, float, 0.0, )

/* Boost once an instruction prefetch has hit the demoted line. Keep it below the receiving
   cache's associativity -- at or above it the boost outranks recency outright, which is what
   drove the icache from 2.45 to 6.0 misses per 1K instructions in the placement runs. REPL_MLP
   only. */
DEF_PARAM(instr_upfill_promote_lambda, INSTR_UPFILL_PROMOTE_LAMBDA, float, float, 0.0, )

/* ============ LEAD-TIME DIRECTED INSTRUCTION PLACEMENT (--fdip_delta_place) ============
   ONE LEVEL OWNS EACH INSTRUCTION LINE. When a demand instruction fetch merges into an
   in-flight instruction prefetch, the gap between the prefetch being sent and the demand
   arriving -- the prefetch's LEAD TIME -- measures how much latency that line's access can
   tolerate. The owner is the furthest-out level that could still have delivered inside it:

     lead >= --l1_cycles    (the LLC access latency)   LLC owns it
     lead >= --mlc_cycles   (the MLC access latency)   MLC owns it
     lead <  --mlc_cycles                              L1I owns it
     demand that merged no prefetch at all             L1I owns it  (there was no lead time)
     prefetch no demand ever merged                    LLC owns it  (nobody was waiting), or
                                                       no level does, under
                                                       --fdip_delta_unmerged_pref_bypass_llc

   THE EDGES ARE THE LATENCY PARAMS THEMSELVES, not copies of their values: re-time a cache and
   the rule re-times with it, because "could this level have delivered inside the lead time" is
   a question about the modelled latency and nothing else. There is deliberately no separate
   pair of threshold knobs to drift out of sync with the machine being modelled.

   AN L1I-OWNED LINE MAY ALSO BE KEPT further out, at its own lambda -- see
   --fdip_delta_l1i_backup_level below. Off by default.

   THE OWNER ALLOCATES AND TAKES --fdip_delta_lambda; THE OTHER LEVELS DO NOT ALLOCATE AT ALL.
   The L1I always receives the line because fetch cannot proceed otherwise, but prioritises it
   only when it owns it. Ordering inside a priority class is plain recency, which REPL_MLP gives
   for free: the bonus is added to the LRU stack position, so equal-boost lines stay in LRU
   order.

   WHY LEAD TIME IS THE RIGHT SIGNAL. It is the only direct measurement the machine has of how
   early this line was needed relative to when it was asked for. A line whose prefetch had 30
   cycles of head start can be refetched from the LLC next time without the front end noticing;
   one whose prefetch was caught after 3 cycles cannot survive anything but an L1I hit. Cost and
   boundness say how much a miss HURT; this says how far away the line can afford to live.

   WHAT IT COSTS, STATED UP FRONT: with no backup level configured, an L1I-owned line exists
   nowhere else on chip, so an L1I eviction sends the next fetch to memory. Instruction lines are
   most of the MLC on these traces, so expect memory traffic to move before IPC does, and measure
   that first. --fdip_delta_l1i_backup_level is the knob that buys that back.

   REQUIRES REPL_MLP (policy 9) on whichever of the MLC and LLC you want to honour the bonus;
   the L1I is switched to REPL_MLP automatically, which is why this conflicts with
   --td_fe_rrip_mark (both claim the L1I policy) and with --load_prio_stats (the level table
   cannot enumerate a third sticky term). Instruction traffic only: data fills are untouched.

   MEASURE BEFORE YOU BELIEVE THE BUCKETS. MEM_REQ_FDIP_CYCLE_DELTA / MEM_REQ_FDIP_BUFFER_HIT
   already give the mean lead time of merged FDIP prefetches on any existing run. If almost every
   merge lands in one bucket the policy degenerates to a single level -- and since the edges are
   the latencies, the fix is then a different RULE, not a re-cut threshold. */
DEF_PARAM(fdip_delta_place, FDIP_DELTA_PLACE, Flag, Flag, FALSE, )

/* Boost for a line at its OWNING level, in LRU stack positions. Shared by all three levels: the
   placement decision is WHICH level protects the line, not how much. 0 (the default) leaves the
   allocation behaviour in place with no protection, which is the control arm for the lambda. */
DEF_PARAM(fdip_delta_lambda, FDIP_DELTA_LAMBDA, float, float, 0.0, )

/* --fdip_delta_unmerged_pref_bypass_llc: a prefetch no demand ever merged into fills the L1I
   and NOTHING ELSE -- declined by both the MLC and the LLC, and unprioritised in the L1I.

   The default instead lets such a prefetch own an LLC way, on the theory that a timely prefetch
   is one whose demand simply has not arrived yet. This knob takes the opposite position: a
   prefetch earns shared capacity only by having been CAUGHT IN FLIGHT by a demand, which is the
   only evidence in this scheme that anything wanted it. Everything else is speculation holding
   an LLC way.

   It is the sharpest capacity lever here, because on these traces most instruction prefetches
   are never merged -- so this decides what the bulk of the FDIP stream is allowed to occupy.
   Note it interacts with --mlp_lin_pref_lambda, which DEMOTES prefetch-installed lines rather
   than refusing them: with both on, the few prefetch lines that still get in are also pushed
   down, which is two mechanisms aimed at one population. */
DEF_PARAM(fdip_delta_unmerged_pref_bypass_llc, FDIP_DELTA_UNMERGED_PREF_BYPASS_LLC, Flag, Flag, FALSE, )

/* --fdip_delta_l1i_prio: does the L1I apply the placement priority, or only hold the line?

     1 (DEFAULT)  the icache runs REPL_MLP so an L1I-owned line takes --fdip_delta_lambda there.
     0            the icache keeps its ordinary policy and stages no class; placement still
                  decides ALLOCATION at the MLC and LLC exactly as before, and the L1I still
                  receives every line. Only the L1I's ordering is left alone.

   WHY YOU WANT 0. The icache is 8-way here, so a lambda at or above 8 makes the boost dominate
   recency outright: every unboosted line -- which is every timely prefetch, since those are
   LLC-owned and unprioritised in the L1I -- ranks below every boosted one regardless of age, and
   is evicted before the demand that would have used it. Measured: ICACHE misses go from 2.45 to
   ~6.0 per 1K instructions, and that single effect accounts for most of the arm's IPC loss. At
   lambda 4 (below associativity) the boost biases instead of dominating and the icache stays
   healthy. This knob removes the risk entirely rather than relying on the lambda staying small.

   It also frees --td_fe_rrip_mark to run alongside placement, since the two no longer contend
   for the L1I policy. */
DEF_PARAM(fdip_delta_l1i_prio, FDIP_DELTA_L1I_PRIO, Flag, Flag, TRUE, )

/* --fdip_delta_hit_pins: an unmerged instruction prefetch that HITS a resident line pins that
   line to the level that served it -- it becomes DELTA_PRIO_OWNER there and takes
   --fdip_delta_lambda, on top of the recency update the access already performs.

   WHY. Ownership is otherwise decided once, at fill, from a single lead-time measurement, and
   nothing ever revisits it. A hit is the feedback that rule never collects: this level held the
   line and something wanted it. It is also the only evidence available for an unmerged prefetch,
   which by definition stalled nobody and so has no lead time to classify.

   PROMOTE-ONLY, so a line cannot oscillate. A line already OWNER stays put; a BACKUP copy is
   promoted to an owner in its own right, since the evidence is identical.

   NOTE A HIT PRODUCES NO FILL, so without this the hit changes nothing about placement -- the
   line simply keeps whatever class its fill gave it and ages out on recency. That is the
   behaviour at 0, and it is what every run before this knob did. */
DEF_PARAM(fdip_delta_hit_pins, FDIP_DELTA_HIT_PINS, Flag, Flag, FALSE, )

/* --fdip_delta_l1i_backup_level: the level that ALSO keeps an L1I-owned line, so it is not the
   only copy on chip.

     0  none (DEFAULT)  the strict rule: an L1I-owned line lives in the L1I alone, and an L1I
                        eviction sends the next fetch to memory.
     1  MLC             ... if --mlc_present. Naming an absent level would otherwise silently
                        mean "no backup", so the presence test is explicit.
     2  LLC

   WHY IT EXISTS. The strict rule gives the shortest-lead-time lines -- the ones the front end
   was most exposed to -- the least retention anywhere, which inverts what their lead time was
   telling you. A backup keeps that line reachable on chip at a cost the lambda controls, so the
   placement idea can be tested without also testing "evict instruction lines to memory".

   It is a COPY, not a second owner: it carries --fdip_delta_l1i_backup_lambda, not
   --fdip_delta_lambda, so the backup level can hold it loosely (lambda 0 is allocate-with-no-
   protection, a pure backstop) while the L1I holds it tightly. */
DEF_PARAM(fdip_delta_l1i_backup_level, FDIP_DELTA_L1I_BACKUP_LEVEL, uns, uns, 0, )

/* Boost for the BACKUP copy of an L1I-owned line at that level, in LRU stack positions. 0 (the
   default) allocates it with no protection at all, which is the control for the lambda: it
   isolates "the line is reachable on chip" from "the line is protected there". */
DEF_PARAM(fdip_delta_l1i_backup_lambda, FDIP_DELTA_L1I_BACKUP_LAMBDA, float, float, 0.0, )

DEF_PARAM(mlp_lin_dyn_lambda_min, MLP_LIN_DYN_LAMBDA_MIN, float, float, 0.0, )
DEF_PARAM(mlp_lin_dyn_lambda_max, MLP_LIN_DYN_LAMBDA_MAX, float, float, 64.0, )

DEF_PARAM(mlp_lin_data_thresh, MLP_LIN_DATA_THRESH, float, float, 0.5, )
DEF_PARAM(mlp_lin_instr_thresh, MLP_LIN_INSTR_THRESH, float, float, 0.7, )

/* ============ REPL_MLP_PAPER (enum ordinal 23): LIN exactly as published ============
   Select with --mlc_cache_repl_policy 23. Value = Recency + lambda*costq, evict the minimum,
   and nothing else -- no boundness terms, no prefetch term. Those are extensions and live in
   REPL_MLP (ordinal 9). Requires --mlp_cost_stats 1, or every line carries cost 0 and this is
   exactly LRU.

   THE ONE DELIBERATE DEPARTURE FROM THE PAPER IS THE BUCKETING. The quantization edges are the
   equal-population cut points measured on these traces, not the paper's 60-cycle ladder
   saturating at 420 -- that ladder assumed a 400-cycle memory behind the last-level cache and
   here leaves four of its eight codes completely unused with 74% of misses in costq=0.

   Everything else follows the paper, including the wrong-path rule below, which the extended
   REPL_MLP does NOT follow. */
DEF_PARAM(mlp_paper_lambda, MLP_PAPER_LAMBDA, float, float, 4.0, )

/* Wrong-path, the paper's way: "All misses are treated on correct path until they are confirmed
   to be on the wrong path." A miss accrues cost and counts toward N from allocation, and is
   dropped only at branch resolution -- which in Scarab is off_path_confirmed, written by
   recover_memory() and REQUIRING --set_off_path_confirmed 1 (it is never written otherwise).
   DEFAULT FALSE, deliberately. This knob lives in mlp_cost_tracked, which is SHARED by both
   REPL_MLP and REPL_MLP_PAPER despite the mlp_paper_ name -- the cost accumulator is one
   mechanism, not one per policy. Defaulting it TRUE silently changed policy 9's wrong-path
   behaviour from oracle exclusion to NO GATING AT ALL, because off_path_confirmed is never
   written unless --set_off_path_confirmed is on, so the test could never fire. That made every
   earlier policy-9 measurement non-reproducible. Descriptors wanting the paper's rule ask for
   it explicitly and must set --set_off_path_confirmed 1 too; init_memory asserts on the
   combination so it cannot silently degrade again.

   This is a third position, distinct from both --mlp_cost_include_offpath settings: the oracle
   (exclude at allocation, unrealisable) and no gating at all. The paper sits between them. */
DEF_PARAM(mlp_paper_confirm_offpath, MLP_PAPER_CONFIRM_OFFPATH, Flag, Flag, FALSE, )

/* SBAR (paper section 5), for REPL_MLP_PAPER only. Two tag-only ATDs over sampled MLC sets --
   one running LIN at --mlp_paper_lambda, one running LRU -- and a saturating PSEL that moves
   ONLY ON DISAGREEMENT, by the COST of the miss:
     ATD-LRU misses while ATD-LIN hits  -> LIN is doing better -> move PSEL toward LIN
     ATD-LIN misses while ATD-LRU hits  -> move PSEL toward LRU
     both hit or both miss              -> neither is better, PSEL unchanged
   The real cache follows the PSEL's MSB. Scoring only disagreements is what cancels everything
   common to the two directories; it is the mechanism, not an optimisation.

   THE ATDs ARE FULL-WIDTH. They are allocated with the MLC's own set count and only the sampled
   sets are ever touched, so an address lands in the SAME set index it would in the real cache.
   An earlier attempt sized them to the sample count instead, which re-hashed a filtered address
   stream into a smaller directory and made the comparison meaningless. Tag-only, so the extra
   memory is simulator-side and the sets that are never touched cost nothing but address space. */
DEF_PARAM(mlp_paper_sbar, MLP_PAPER_SBAR, Flag, Flag, FALSE, )
DEF_PARAM(mlp_paper_sbar_sets, MLP_PAPER_SBAR_SETS, uns, uns, 32, )
/* PSEL width in bits. The MSB selects, so the counter spans [0, 2^bits) and switches at the
   halfway point. Wider = more hysteresis = slower to change its mind. */
DEF_PARAM(mlp_paper_psel_bits, MLP_PAPER_PSEL_BITS, uns, uns, 10, )

/* Mockingjay (HPCA'22) replacement -- REPL_MOCKINGJAY. Select it with
   --mlc_cache_repl_policy 22 (L2) or --l1_cache_repl_policy 22 (LLC); the policy itself is
   level-agnostic and these knobs apply to whichever level is running it.

   Bypass: Mockingjay declines to allocate a fill whose predicted reuse distance is worse than
   every resident line's. Scarab has no generic bypass path, so this is wired explicitly into
   mlc_fill_line/l1_fill_line. Writebacks are never bypassed (matching the reference, and
   because dropping one would lose dirty data). Turn it off to run victim selection only. */
DEF_PARAM(mockingjay_bypass, MOCKINGJAY_BYPASS, Flag, Flag, TRUE, )
/* Sampler / predictor sizing. -1 uses the reference's capacity-derived value, which assumes an
   LLC: log2(sampled sets) = log2(bytes) - 16 and signature width = log2(bytes) - 10. A 256KB
   8-way L2 derives only 4 sampled sets and an 8-bit signature (256 RDP entries), so raising
   these is usually worthwhile at L2. Signature width is capped at 24 bits. */
DEF_PARAM(mockingjay_log2_sampled_sets, MOCKINGJAY_LOG2_SAMPLED_SETS, int, int, -1, )
DEF_PARAM(mockingjay_pc_signature_bits, MOCKINGJAY_PC_SIGNATURE_BITS, int, int, -1, )
/* Reuse-distance scale: INF_RD = assoc*history - 1 and ETR counts in units of `granularity`
   accesses. INF_RD must stay under 256 (the sampler timestamp is 8 bits), so history must be
   <= 256/assoc; the defaults are the paper's. */
DEF_PARAM(mockingjay_history, MOCKINGJAY_HISTORY, uns, uns, 8, )
DEF_PARAM(mockingjay_granularity, MOCKINGJAY_GRANULARITY, uns, uns, 8, )
/* FDIP Confidence Cache */
// The cache line size is fixed to ICACHE_LINE_SIZE (64 by default). The number of entries in a FDIP UC is FDIP_UC_SIZE / ICACHE_LINE_SIZE. To have 16K (16384) entries, FDIP_UC_SIZE should be 1048576.
DEF_PARAM(  fdip_uc_size                   , FDIP_UC_SIZE                    , uns    , uns     , 0                      ,       )
DEF_PARAM(  fdip_uc_assoc                  , FDIP_UC_ASSOC                   , uns    , uns     , 4                      ,       )
// The insert replacement policy should be one of INSERT_REP_(DEFAULT/LRU/LOWQTR/MID/MRU)
DEF_PARAM(  fdip_uc_insert_replpol         , FDIP_UC_INSERT_REPLPOL          , uns    , uns     , 0                      ,       )
// Allow the map stage to consume ops originating from either the icache or uop cache path in the same cycle.
DEF_PARAM(  map_stage_consume_from_icache_and_uoc_same_cycle, MAP_STAGE_CONSUME_FROM_ICACHE_AND_UOC_SAME_CYCLE, Flag, Flag, TRUE,)
// max uops in queue = uop_queue_length * (UOP_CACHE_WIDTH)
DEF_PARAM(  uop_queue_length               , UOP_QUEUE_LENGTH                , uns    , uns     , 7                      ,       )

/* --early_evict_stats: count lines replaced soon after they were filled.
 *
 * At every fill into the L1I, L1D, MLC and L1 (Scarab's name for the LLC), the line being
 * replaced has its residency measured -- cycle_count at eviction minus cycle_count at its own
 * fill -- and is counted as an eviction, plus as an EARLY eviction if that residency is below
 * that cache's threshold. The clock runs from FILL, not from last access, so a line that was
 * hit repeatedly and then replaced still counts as short-lived; this measures residency, not
 * dead time.
 *
 * The threshold is per cache and derived, not absolute: EARLY_EVICT_LAT_MULT times that
 * cache's own access latency in cycles (DCACHE_CYCLES, ICACHE_LATENCY, MLC_CYCLES, L1_CYCLES).
 * At the default multiplier of 2 and the default latencies that is 4 / 6 / 24 / 48 cycles --
 * deliberately tight, so a hit counts only lines replaced practically on arrival. Raise the
 * multiplier to widen the window; it is a knob precisely so that sweeping it needs no rebuild.
 *
 * Both counters are TARGET-ONLY: they are gated on early_evict_in_roi(), so under
 * --full_warmup they start at the warmup boundary and are on the same window as
 * Periodic_Instructions / Periodic_Cycles. Do NOT divide them by Cumulative_*. */
DEF_PARAM(early_evict_stats, EARLY_EVICT_STATS, Flag, Flag, FALSE, )
DEF_PARAM(early_evict_lat_mult, EARLY_EVICT_LAT_MULT, uns, uns, 2, )

/* --reuse_dist_stats: reuse-distance distribution of MLC and LLC lines, SPLIT BY MARKED CLASS.
 *
 * THE UNIT IS ACCESSES TO THE SET, and the distance runs FROM THE LINE'S LAST ACCESS -- its
 * fill, or its most recent hit -- not from its fill. Both choices matter and neither matches
 * --early_evict_stats, which is cycles and runs from fill:
 *
 *   - ACCESSES, not cycles, because the question is whether a reuse would survive the set's
 *     replacement pressure, and that is counted in competing accesses. It also makes the number
 *     directly comparable to ASSOCIATIVITY: a distance below assoc is a reuse plain LRU already
 *     captures, so only the mass above assoc is what a smarter policy can win.
 *   - FROM LAST ACCESS, because that is reuse distance. From-fill would be residency: a line
 *     hit ten times and then replaced would report one long interval rather than ten short ones.
 *
 * WHY IT IS SPLIT BY CLASS. The marking machinery (--membound_stats and the marked-RRIP
 * policies) asserts that membound / FE-bound lines are worth protecting. That claim is about
 * WHEN they are reused, and until now nothing measured it: MLC_MEMBOUND_HIT says whether a
 * marked line was reused at all, never how far away the reuse was. A marked population whose
 * distances sit below assoc needs no protection -- LRU already catches them -- and one whose
 * distances are unbounded cannot be helped by any capacity-bound policy. Only the band just
 * above assoc is actionable, and this is what shows where the mass actually sits.
 *
 * READ *_NOREUSE FIRST. The histogram necessarily contains only lines that WERE reused, so on
 * its own it is a biased sample. *_NOREUSE counts lines evicted having never been hit, per
 * class, and a policy can raise its protected class's mean distance purely by keeping hopeless
 * lines resident longer -- which moves *_NOREUSE and nothing else. The pair is the measurement;
 * the histogram alone is not.
 *
 * POLICY-INDEPENDENT, like the membound_fill bits it splits on: the counters are maintained on
 * every replacement policy, so an LRU run and a marked-RRIP run are directly comparable. Note
 * the distribution is still a property of the policy as well as the workload -- a policy that
 * evicts a line before its reuse removes that distance from the histogram and adds to
 * *_NOREUSE -- so it measures the reuse the cache ACTUALLY CAPTURED, not the workload's
 * intrinsic reuse. For the latter, run it under a very large cache.
 *
 * WHAT COUNTS AS AN ACCESS. The per-set clock ticks once per REPLACEMENT-UPDATING cache_access,
 * so a distance is the number of accesses that could have evicted the line. Two consequences:
 *   - Probes (update_repl==FALSE) do not tick, and neither do prefetch accesses under
 *     --prefetch_update_lru_mlc 0 / --prefetch_update_lru_l1 0. Both default TRUE and
 *     PARAMS.google does not override them, so on the stock config every access counts.
 *   - A fill does not tick on its own; it is already counted by the access that missed. The one
 *     gap is a fill with no preceding access on that cache (the prefetch-cache promotion path
 *     into the LLC), which stamps the line without advancing the clock. That slightly understates
 *     pressure on those sets and is not corrected, because ticking at both the access and the
 *     fill would double-count every ordinary miss.
 *
 * NOT COVERED: --marked_rrip_stream_buf. A hit served from the one-line victim buffer records no
 * distance, because the buffer holds a line that is not in any set and so has no set clock to
 * measure against. The buffer is off by default; with it on, its hits are simply absent here.
 *
 * WINDOW: target-only, on the same early_evict_in_roi() gate as the *_EVICT counters, so these
 * sit on the Periodic_* window. Divide by Periodic_Instructions, never by Cumulative_*. */
DEF_PARAM(reuse_dist_stats, REUSE_DIST_STATS, Flag, Flag, FALSE, )

/* --load_prio_stats: per-PRIORITY-LEVEL load tracker for the MLC and the LLC.
 *
 * TWO HALVES, WITH DIFFERENT POLICY REQUIREMENTS. Read this before concluding a chain is broken:
 *
 *   - The SET-COMPOSITION chains (*_COMP_*) are POLICY-INDEPENDENT. They read only the traffic class
 *     stamped on each line at its fill, which every insert path records, so they are populated under
 *     REPL_TRUE_LRU, SRRIP, Mockingjay, marked-RRIP -- anything. --load_prio_stats 1 alone is enough,
 *     and they need neither --mlp_cost_stats nor a particular repl policy. That is deliberate: the
 *     baseline a priority-aware policy gets compared against needs the same composition numbers.
 *
 *   - The PRIORITY chains (*_PRIO_*) are REPL_MLP ONLY, because a level is an index into that
 *     policy's own value function and means nothing elsewhere. Set --mlc_cache_repl_policy 9 and/or
 *     --l1_cache_repl_policy 9, and --mlp_cost_stats 1, or they stay at zero. A cache not running
 *     REPL_MLP leaves set_miss_ctr NULL, which is the enable test on those hot paths, so an
 *     unrelated run pays one null check per access.
 *
 * So an LRU run with --load_prio_stats 1 gives you the full composition picture and no priority
 * breakdown, which is a valid and useful configuration rather than a half-broken one.
 *
 * L1_PRIO_* (THE LLC) IS WEAKER THAN MLC_PRIO_*, and the reasons are pre-existing properties of
 * REPL_MLP rather than of this instrumentation. --l1_cache_repl_policy 9 does select REPL_MLP on the
 * LLC and the levels are computed exactly as on the MLC, but:
 *
 *   - LLC LINES CARRY AN MLC-DENOMINATED COST. req->mlp_cost accumulates over the MLC-miss window,
 *     and the LLC fill stages it unchanged, so costq on an LLC line answers "what did the miss that
 *     fetched me cost at the MLC", not "what does an LLC miss on me cost". Nothing measures the
 *     latter.
 *   - THE COSTQ EDGES WERE CALIBRATED ON MLC DEMAND MISSES (MLC_MLP_COST_*, 34.8M samples on the
 *     google traces). Bucketing LLC lines with them is a calibration mismatch, so the LLC level
 *     histogram may bunch into fewer levels than the MLC's. Re-cut with --mlp_cost_edges from an
 *     LLC-side cost histogram if the LLC is the object of study.
 *   - THE TWO MUTABLE PENALTIES ARE NEVER UPDATED ON THE LLC. cache_mark_written and
 *     cache_clear_offpath are called for the MLC only, so on the LLC was_written and
 *     offpath_unproven keep their fill-time values for the line's whole life. This does NOT affect
 *     the levels here, which exclude both terms by construction -- but it does mean REPL_MLP is a
 *     different policy on the LLC than on the MLC, so do not read an MLC-vs-LLC difference in these
 *     chains as a property of cache level alone.
 *
 * ALSO: FOUR KNOBS SILENTLY OVERRIDE THE REPL POLICY to REPL_MARKED_RRIP, ignoring
 * --mlc_cache_repl_policy / --l1_cache_repl_policy entirely. All default FALSE:
 *
 *     MLC  (--td_load_rrip_mark AND --td_load_rrip_on_mlc), or --td_fe_rrip_on_mlc,
 *          or --td_combined_on_mlc
 *     LLC  --td_combined_on_l1
 *
 * With any of them set, that cache's *_PRIO_* chains go silent while its *_COMP_* chains keep
 * working -- which looks exactly like a broken priority hookup and is not one. Check these before
 * debugging anything else. Note the MLC condition is a CONJUNCTION for the first pair:
 * --td_load_rrip_mark alone does not override the MLC unless --td_load_rrip_on_mlc is also set.
 *
 * WHAT A PRIORITY LEVEL IS. The level is the line's BOOST -- the non-recency part of the REPL_MLP
 * value function, i.e. how far the policy displaces the line from where its recency alone would
 * put it:
 *
 *     boost = --mlp_lin_lambda * mlp_lin_costq(mlp_cost) + mlp_lin_bound_term(line)
 *
 * Both terms are already weighted, so the boost is in LRU STACK POSITIONS and is directly
 * comparable against associativity: a boost of 4 at the 16-way MLC is a quarter of the stack.
 * The expression is shared with find_repl_entry (mlp_lin_prio_boost), not copied, so the tracker
 * cannot drift from the policy it measures.
 *
 * ONLY THOSE TWO TERMS. find_repl_entry's boost also SUBTRACTS --mlp_lin_pref_lambda,
 * --mlp_lin_store_lambda and --mlp_lin_offpath_lambda. Those are deliberately excluded, and that
 * is what makes a level sticky at all: was_written is set long after the fill by
 * cache_mark_written (a writeback hitting a resident line) and offpath_unproven is cleared by
 * cache_clear_offpath (an on-path hit vindicating a wrong-path fill), so a level built from them
 * would silently stop describing the line it was stamped on. The two terms kept are both fully
 * determined at fill and never rewritten. If you are sweeping those three penalties, note that
 * the tracker will not see them -- two runs differing only in --mlp_lin_store_lambda produce
 * identical levels.
 *
 * STICKY AT FILL. A line's level is stamped once, at its fill, and every event in its life --
 * every hit, and its eviction -- is charged to that level. So a chain reads "lines that ARRIVED
 * at priority L behaved like this", which is the attribution that makes the per-level hit rate
 * and mean reuse count well defined. The alternative, recomputing live at each event, would let
 * one line contribute to several levels and turn every per-level total into events-not-lines.
 *
 * LEVELS ARE NOT COMPARABLE ACROSS A LAMBDA SWEEP. costq is 0..7 and the bound term is one of
 * {0, --mlp_lin_data_lambda, --mlp_lin_instr_lambda}, so the boost takes at most 24 distinct
 * values; the level is the index of the line's boost in that set sorted ASCENDING, so level 0 is
 * always the least protected. But both the NUMBER of levels and the boost a given level stands
 * for depend on the lambdas: with --mlp_lin_data_lambda 0 (the default) the bound term vanishes
 * and there are exactly 8 levels, one per costq. Worse, lambdas can COLLIDE -- at
 * --mlp_lin_lambda 1 --mlp_lin_data_lambda 2, a costq-2 line with no bound mark scores the same
 * 2.0 as a costq-0 line with one, and the two share a level. That is correct (equal boost is
 * equal protection, and the policy cannot tell them apart either) but it means PRIO_L3 in one run
 * is not PRIO_L3 in another. Read *_PRIO_NUM_LEVELS and *_PRIO_BOOST_L<n> to recover what each
 * level meant in a given run before comparing anything across runs.
 *
 * THE UNIT IS MISSES TO THE SET, for both residency and reuse distance. A miss is the event that
 * allocates and therefore the event that can displace a resident line; a hit costs the resident
 * lines nothing. So a residency of N misses says the line survived N allocation opportunities,
 * and a reuse distance of N says N allocation opportunities passed between two uses. Both are
 * directly comparable against ASSOCIATIVITY -- a reuse within fewer misses than the set has ways
 * was never at risk, so only the mass at or above assoc is what a priority-aware policy can
 * actually convert.
 *
 * NOT THE SAME UNIT AS --reuse_dist_stats, which measures ACCESSES to the set on its own
 * independent per-set counter. Both knobs work with or without the other, but a distance from one
 * must never be divided into or compared against a distance from the other. The two also differ
 * at the bottom of the range: --reuse_dist_stats has a minimum of 1 because it counts the access
 * itself, while here the minimum is 0 -- no miss intervened, so nothing could have displaced the
 * line.
 *
 * WHAT THE CHAINS ARE. Per level: FILL, HIT, EVICT, NOREUSE, and the two sums
 * RESIDENCY_MISSES / REUSE_MISSES. Derive the four metrics as
 *
 *   hit rate         = HIT / (HIT + FILL)
 *   mean reuses/line = HIT / FILL
 *   mean residency   = RESIDENCY_MISSES / EVICT      (in misses to the set)
 *   mean reuse dist  = REUSE_MISSES / HIT            (in misses to the set)
 *
 * The hit-rate denominator is HIT + FILL and not an access count, because every access that
 * touches a level-L line is either the miss that filled it or a later hit on it -- there is no
 * third kind, and a miss on a line that is not resident has no level to charge.
 *
 * READ *_NOREUSE BEFORE THE REUSE-DISTANCE SUM, for the same reason --reuse_dist_stats says so:
 * REUSE_MISSES can only contain lines that WERE reused, so alone it is a biased sample. A policy
 * that protects a level can raise that level's mean reuse distance purely by keeping hopeless
 * lines resident longer, and that moves NOREUSE and nothing else. The pair is the measurement.
 *
 * WHAT THE CACHE HOLDS, vs what it admits. Two separate set walks run at every fill, before the
 * arriving line has displaced anything:
 *   - *_PRIO_OCCUP_L<n> adds, per fill, the number of resident lines at each level. Summed over a
 *     run this is OCCUPANCY -- what the cache actually contains -- which the per-fill event chains
 *     cannot give: a level can take a small share of fills and still hold most of the cache, or
 *     the reverse. Divide a level's OCCUP by the total over all levels for its share of capacity.
 *   - *_COMP_<class>_<k> histogram how many of the set's ways held each traffic class, k running
 *     0..16 (= MLC and LLC associativity). Set-wide, NOT split by level.
 *
 * TRAFFIC CLASSES. Six DISJOINT classes that partition Mem_Req_Type, so their counts over a set
 * sum to its valid ways:
 *
 *     COMP_IFETCH  IFETCH                               demand instruction fetch
 *     COMP_IPREF   IPRF, UOCPRF, FDIPPRFON, FDIPPRFOFF  instruction prefetch
 *     COMP_LOAD    DFETCH                               demand data load
 *     COMP_DPREF   DPRF                                 data prefetch
 *     COMP_STORE   DSTORE                               demand store
 *     COMP_WB      WB, WB_NODIRTY                       writeback from the level above
 *
 * plus four COARSER views that overlap the six and each other:
 *
 *     COMP_ALL_INSTR         = IFETCH + IPREF        every instruction line
 *     COMP_ALL_PREF          = IPREF  + DPREF        every prefetched line
 *     COMP_ALL_READ          = IFETCH + LOAD         every DEMAND read
 *     COMP_ALL_DATA_NONLOAD  = DPREF + STORE + WB    data no demand load brought in
 *
 * ALL_READ IS DEMAND ONLY -- prefetch is excluded on purpose, since a prefetch is speculative
 * rather than a read the program issued and ALL_PREF already accounts for it. It is therefore NOT
 * a read/write split: ALL_READ + COMP_STORE + COMP_WB falls short of the set's valid ways by
 * exactly COMP_ALL_PREF. ALL_DATA_NONLOAD + COMP_LOAD is the whole data side, which is why there is
 * no COMP_ALL_DATA chain.
 *
 * THE ALL_* VIEWS ARE NOT DERIVABLE from the six, which is why they are chains of their own. These
 * are histograms of per-fill occupancy counts, and histograms do not add -- COMP_IFETCH_3 and
 * COMP_IPREF_2 are separate events about separate fills and say nothing about a set holding 5
 * instruction lines. Summing the two CSV columns gives a meaningless number; use COMP_ALL_INSTR.
 * Adding a fifth view means adding a chain and a sum in load_prio_snapshot_set; it cannot be done
 * in a plot script.
 *
 * ON PARAMS.google expect COMP_DPREF to be ZERO, COMP_ALL_PREF to equal COMP_IPREF, and
 * COMP_ALL_DATA_NONLOAD to be COMP_STORE + COMP_WB: the data prefetchers are off
 * (--pref_framework_on 0, --pref_stream_on 0), so every prefetch is an FDIP instruction prefetch.
 * Prefetch occupancy is still fully visible, which it was not when instruction prefetch was folded
 * into the instruction class.
 *
 * The six counts fall short of the set's valid ways only for lines of an unmapped type
 * (MRT_MIN_PRIORITY), which are walked but histogrammed nowhere; invalid ways hold nothing and are
 * counted nowhere, so a set that is not yet full falls short of 16.
 *
 * WHAT COUNTS AS A MISS. The per-set clock ticks once per REPLACEMENT-UPDATING cache_access that
 * fails to find its line, so a distance is the number of accesses that could actually have
 * evicted the line. Three consequences, the first two shared with --reuse_dist_stats:
 *   - Probes (update_repl==FALSE) do not tick. Neither do prefetch accesses under
 *     --prefetch_update_lru_mlc 0 / --prefetch_update_lru_l1 0; both default TRUE and
 *     PARAMS.google does not override them, so on the stock config every miss counts. Turning
 *     either off narrows this clock as well as the LRU stack, which is consistent but worth
 *     knowing when comparing across those runs.
 *   - The prefetch-cache promotion path into the LLC fills without a preceding cache_access on
 *     the LLC, so it stamps a line without having ticked that set's miss clock. That slightly
 *     understates residency and reuse distance on those sets. Not corrected, because ticking at
 *     the fill as well would double-count every ordinary miss, which arrives via cache_access.
 *   - REPL_IDEAL and REPL_SHADOW_IDEAL may still serve an access from a side structure after the
 *     array lookup fails, so those two do not tick either. Neither is ever tracked (the tracker
 *     is REPL_MLP only), so this costs nothing in practice.
 *
 * NOT COVERED: --marked_rrip_stream_buf, for the same reason --reuse_dist_stats is not. A hit
 * served from the one-line victim buffer holds a line that is in no set, so there is no set clock
 * to measure it against. The buffer requires REPL_MARKED_RRIP, which is never tracked here, so it
 * cannot interact with this knob at all.
 *
 * WINDOW: TARGET-ONLY. Every counter is gated on early_evict_in_roi(), the same gate as
 * --early_evict_stats and --reuse_dist_stats, so under --full_warmup they start at the warmup
 * boundary and sit on the Periodic_* window. Divide by Periodic_Instructions, NEVER by
 * Cumulative_*, which spans warmup as well. The per-line stamping is deliberately NOT gated --
 * a line filled during warmup and hit inside the target window must still carry a level. */
DEF_PARAM(load_prio_stats, LOAD_PRIO_STATS, Flag, Flag, FALSE, )

/* --delta_prio_stats: per-PLACEMENT-CLASS hit/miss accounting for the L1I, the MLC and the LLC.
 *
 * The class is Cache_Entry.delta_prio, a Delta_Prio: NONE, OWNER, BACKUP, UPFILL, UPFILL_HIT,
 * NO_PREF, LATE_PREF. Those classes are produced by --fdip_delta_place, --instr_upfill and the
 * two miss-reason lambdas, and until this knob existed each was visible only through a single
 * fill counter (MLC_NO_PREFETCH_FILL and friends) that said how many arrived and nothing about
 * whether any of them paid off.
 *
 * WORKS UNDER ANY REPLACEMENT POLICY. Unlike --load_prio_stats, which needs REPL_MLP because a
 * priority level is an index into that policy's boost table, a placement class is stamped by the
 * insert path itself. --instr_upfill is standalone, so running it under REPL_TRUE_LRU and
 * measuring it here is the intended baseline, not a degraded mode.
 *
 * COMBINE WITH --load_prio_stats 1 TO GET THE WHOLE PICTURE OF WHAT THE CACHE HOLDS. That knob's
 * composition chains (*_COMP_<traffic class>_<n>) and the OCCUP_<class> chains here are two
 * marginals of the SAME fill-sampled occupancy -- same trigger point, same ROI gate, and since
 * instr_upfill_insert now drives both walks, the same sample set. Because every delta_prio setter
 * is instruction-gated, a non-NONE class is an instruction line BY CONSTRUCTION, and the joint
 * breakdown follows:
 *     instruction ways        = COMP_ALL_INSTR / SAMPLES
 *     marked instruction ways = sum(OCCUP_C, C != NONE) / SAMPLES
 *     unmarked instruction    = instruction - marked        (must be >= 0; a validity check)
 *     data ways               = OCCUP_NONE / SAMPLES - unmarked instruction
 *     untagged (OTHER) ways   = sum(OCCUP_*) - sum(COMP over the 6 disjoint classes)
 * That last line is otherwise unobtainable: OTHER has no chain of its own. And COMP_LOAD + DPREF
 * + STORE + WB is an INDEPENDENT estimate of the data ways, so the two can be cross-checked.
 *
 * ONE CAVEAT ON THE TRAFFIC-CLASS SPLIT: instr_upfill_insert stages demoted lines as
 * LOAD_PRIO_TC_IFETCH, so under --instr_upfill, COMP_IFETCH at the MLC and LLC is demand ifetch
 * PLUS demotions and the IFETCH/IPREF split is no longer provenance. COMP_ALL_INSTR is still the
 * correct total, so the arithmetic above is unaffected -- but do not read that split as
 * demand-versus-prefetch. Use DFILL for that.
 *
 * WHAT COMBINING COSTS: a live placement-class lambda (--fdip_delta_place, --instr_upfill_lambda,
 * --instr_upfill_promote_lambda, --instr_nopref_lambda, --instr_latepref_lambda) adds a third
 * sticky term to the REPL_MLP boost, which the priority level table cannot enumerate. On such a
 * run --load_prio_stats keeps its composition half and DISABLES its level half: every *_PRIO_*
 * chain comes out empty and a WARNING at init says so. Composition and these chains are
 * unaffected. With every placement lambda at 0 -- labelling only -- the level half survives.
 *
 * THE FIVE CHAINS, per cache (MLC_DELTA_*, L1_DELTA_* for the LLC, ICACHE_DELTA_*):
 *
 *   FILL_<C>    lines of class C admitted, by ANY route -- demand, prefetch or demotion.
 *   DFILL_<C>   the DEMAND-caused subset of those: the allocating access was MRT_IFETCH,
 *               MRT_DFETCH or MRT_DSTORE. Exactly the population HIT_<C> counts.
 *   HIT_<C>     DEMAND accesses that hit a class-C line. The guard is the same three types the
 *               L1_HIT / MLC_HIT counters use, so these are comparable with them. Prefetch hits
 *               are NOT here -- read RELEASE_<C> for those. Probes are not here either: the
 *               oracle and warmup lookups pass update_repl FALSE, --perfect_icache synthesizes a
 *               hit with no line behind it, and FDIP's icache probe never satisfies a fetch.
 *   EVICT_<C>   class-C lines replaced.
 *   HITS_<C>    those victims' DEMAND references, SUMMED -- same population as HIT_<C>. Divided
 *               by EVICT_<C> (its ratio column) this is the mean number of times a class-C line
 *               was used per completed residency.
 *   NOREUSE_<C> victims never referenced at all, as a fraction of EVICT_<C>. Read this BEFORE
 *               HITS_<C>: a class can raise its mean purely by holding a few popular lines
 *               longer while the rest die untouched, and only NOREUSE separates the two.
 *   OCCUP_<C>   resident class-C lines, summed once per fill. Divided by the chain's total this
 *               is the class's share of CAPACITY, which the admission counts cannot give --
 *               a class can take 2% of fills and hold 40% of the array, or the reverse.
 *
 *   THE PER-CLASS DEMAND HIT RATE IS HIT_C / (HIT_C + DFILL_C), NOT HIT_C / (HIT_C + FILL_C).
 *   FILL_C counts prefetch fills and demotions, which no demand access asked for; pairing it
 *   with a demand-only numerator mixes populations and understates every class that is mostly
 *   prefetched -- which, on instruction traffic, is all of them. FILL_C - DFILL_C is the
 *   speculative-plus-demoted share of admissions and is worth reading on its own.
 *
 *   There is deliberately no per-class MISS chain, because a line that is not resident has no
 *   class -- "the miss rate of class C" is only answerable as 1 - HIT_C/(HIT_C + DFILL_C).
 *
 * FILL AND EVICT DO NOT BALANCE, and the shortfall is intended. A line can also leave by
 * --instr_upfill_hit_invalidate, which is not a replacement; those exits are counted separately
 * as RELEASE_<C>. FILL == EVICT + RELEASE + (still resident at end of run), per class. Check it:
 * (EVICT_C + RELEASE_C) / FILL_C should sit at 1.00 for every class, and a departure from that
 * means a route into or out of the level is not hooked.
 *
 * RELEASE_<C> / FILL_<C> IS THE PER-CLASS PAYOFF under hit-invalidate, and it is the one reuse
 * number here that does not depend on delta_hits at all. A released line is one that was asked
 * for -- by a demand OR a prefetch -- and delivered up to the L1I. Its complement, EVICT_C /
 * FILL_C, is the share that died in place. Prefer this over HITS/NOREUSE when both are available,
 * and note that under hit-invalidate NOREUSE_C is 100% for every instruction class BY
 * CONSTRUCTION: a referenced line leaves through RELEASE, so anything still around to be evicted
 * was never referenced.
 *
 * A CLASS IS FILL HISTORY, not a live attribute, with two deliberate exceptions:
 * cache_promote_upfill moves UPFILL to UPFILL_HIT and cache_mark_delta_owner installs OWNER, so
 * a line can be FILLed as one class and EVICTed as another. The chains are charged at the moment
 * each event happens, so that re-labelling shows up as an asymmetry between FILL_UPFILL and
 * EVICT_UPFILL rather than being hidden.
 *
 * COST: up to five STAT_EVENTs per fill and one per hit, plus one O(assoc) walk per fill for
 * OCCUP -- the same shape and the same cost as --load_prio_stats' occupancy walk. Off by default.
 *
 * WHERE THE PER-LINE REFERENCE COUNT IS CHARGED, and why it matters. Cache_Entry.delta_hits is
 * bumped by cache_note_delta_hit at the COUNTING site, not inside cache_access. cache_access is
 * re-run on retry (mem_complete_mlc_access / mem_complete_l1_access return FALSE and are driven
 * again on a later cycle whenever the access cannot complete), so an increment there fires once
 * per retry -- the same hazard the comment beside L1_MEMBOUND_HIT documents. It would also catch
 * prefetch accesses and FDIP's icache probe. Deferring it costs one generation check: if the way
 * turned over between the access and the count (done_func can demote an L1I victim straight back
 * into this cache), the reference is DROPPED rather than charged to the wrong line.
 *
 * WHICH CLASSES A RUN CAN ACTUALLY SEE. This knob only reads classes; it does not create them,
 * and each one needs its own mechanism on:
 *   OWNER, BACKUP            --fdip_delta_place (BACKUP also needs --fdip_delta_l1i_backup_level)
 *   UPFILL                   --instr_upfill
 *   UPFILL_HIT               --instr_upfill plus --instr_upfill_promote_lambda, and NOT
 *                            --instr_upfill_hit_invalidate -- those two are alternative answers
 *                            to the same event and instr_upfill_note_hit yields to the release
 *   NO_PREF                  --instr_nopref_lambda NONZERO
 *   LATE_PREF                --instr_latepref_lambda NONZERO
 * The last two are the trap: instr_miss_class self-gates on its lambda, so a run that leaves the
 * lambda at 0 to measure the classes WITHOUT protecting them will find both chains empty. Set a
 * small nonzero lambda to label the lines. That is not free of side effects -- the miss class
 * OVERRIDES the placement class on a fill where both apply -- so it is behaviour-neutral only
 * when --fdip_delta_place is off. With placement on, a labelling-only run is not available and
 * the two mechanisms have to be compared at their real lambdas.
 *
 * WINDOW: TARGET-ONLY, on the early_evict_in_roi() gate, exactly like --load_prio_stats and
 * --early_evict_stats. Divide by Periodic_Instructions, NEVER by Cumulative_*. The per-line
 * delta_hits counter is NOT gated, so a line filled in warmup and hit inside the target window
 * still reports its hits. */
DEF_PARAM(delta_prio_stats, DELTA_PRIO_STATS, Flag, Flag, FALSE, )

/* --mlp_cost_stats: accumulate the MLP-based cost of every demand MLC miss, per
 * "A Case for MLP-Aware Cache Replacement" (Qureshi et al., ISCA'06), Algorithm 1.
 *
 * The paper's cost model: a miss serviced alone stalls the processor for its full latency,
 * while N misses serviced concurrently share that stall. So each cycle a miss is outstanding
 * it accrues 1/N, where N is the number of demand misses outstanding that cycle. A fully
 * isolated miss therefore ends with mlp_cost == its own latency; a miss that always overlapped
 * 4 others ends with roughly a quarter of it. Cost is what the replacement policy wants to
 * protect, NOT latency -- that is the whole point of the paper.
 *
 * Scarab has no MLC-level MSHR object, so the "MSHR" here is the subset of mem->req_buffer[]
 * with mlc_miss set and mlc_miss_satisfied clear. The walk is O(total_mem_req_buffers) per
 * uncore cycle, which is why this is a knob and defaults off.
 *
 * Counted as demand: IFETCH, DFETCH, DSTORE. Prefetches and writebacks are excluded, matching
 * the paper ("We count instruction accesses, load accesses, and store accesses that miss in
 * the largest on-chip cache as demand misses"). Off-path requests are excluded via
 * req->off_path. Note the paper's hardware instead treats a miss as correct-path until the
 * branch resolves, which would be off_path_confirmed here; off_path is the cleaner signal for
 * calibrating quantization, since it never credits cost to a miss that was never needed.
 *
 * Cost is accumulated as a double, in cycles. The paper's 9.5 fixed-point format is a statement
 * about what the HARDWARE would store, and modelling it here would only bias the measurement:
 * an integer 1/N truncates, always downward, every cycle of every miss. Quantization belongs on
 * top of an exact value -- which is the point of the histogram this feeds -- not inside the
 * accumulator producing it.
 *
 * The 1/N is applied per cycle, as the paper's Algorithm 1 states it, and cannot be deferred:
 * summing outstanding cycles and dividing once at the end computes latency/mean(N), an
 * arithmetic mean where the model needs a harmonic one. For a miss outstanding two cycles at
 * N=1 then N=4, the cost is 1/1 + 1/4 = 1.25, while 2/mean(1,4) = 0.8.
 *
 * WINDOW: these counters are NOT gated on an ROI predicate, so under --full_warmup they span
 * warmup + target, like every ordinary DEF_STAT counter. Divide them by Cumulative_*, never by
 * Periodic_*. See the comment on membound_in_roi() in memory.c for why that distinction bites. */
DEF_PARAM(mlp_cost_stats, MLP_COST_STATS, Flag, Flag, FALSE, )

/* --mlp_cost_exclude_stores: treat MRT_DSTORE as if it were not a demand miss, for cost
 * purposes only. Default FALSE, which is the paper's definition ("instruction accesses, load
 * accesses, and store accesses that miss in the largest on-chip cache").
 *
 * ATTRIBUTION EXPERIMENT. Stores are 28.7% of MLC demand misses on the google traces and they
 * occupy MSHRs exactly like loads (mem_req_type_is_demand covers all three types), so today
 * they both accrue MLP cost and count toward N. That gives REPL_MLP a capability the
 * marked-RRIP scheme never had: a store-filled line can be ranked ABOVE an unbound load's,
 * whereas marked-RRIP inserted both at `basic` and could not tell them apart. So any win LIN
 * shows over marked-RRIP might come from the cost model -- or merely from stores having become
 * rankable at all. Turning this on removes that capability while leaving everything else
 * intact, and the difference is the answer.
 *
 * TWO EFFECTS, BOTH INTENDED, and they are not separable through this knob:
 *   1. Store-filled lines carry mlp_cost 0, quantize to level 0, and are evicted first among
 *      equals -- i.e. stores go back to being indistinguishable from the cheapest loads.
 *   2. Stores leave N, so a load overlapping four store misses is charged 1/1 for those cycles
 *      instead of 1/5. Load costs RISE and the cost distribution should sharpen.
 * Effect 2 is arguably the more defensible model on its own merits: a store does not block
 * dispatch the way a load does, so counting it as a concurrent stall-sharer overstates how
 * much company a load really had. If the sweep shows a win here, it is worth separating which
 * of the two effects produced it before concluding anything about stores.
 *
 * Expect MLC_MLP_COST_NUM to fall by roughly the store share and mean cost to rise; that is
 * the confirmation the knob took effect, and no separate stat is needed for it. Costs measured
 * with this on are NOT comparable to costs measured with it off -- the quantization edges in
 * cache_lib.c were cut from a run with stores included. */
DEF_PARAM(mlp_cost_exclude_stores, MLP_COST_EXCLUDE_STORES, Flag, Flag, FALSE, )

/* --mlp_cost_include_offpath: stop excluding wrong-path misses from the cost accounting.
 * Default FALSE, which keeps the oracle exclusion (req->off_path, known at allocation).
 *
 * THIS IS THE HARDWARE-REALISABLE END OF THE SPECTRUM, and there are three points on it:
 *
 *   FALSE (default)  ORACLE. A wrong-path miss never accrues cost and never enters N, from the
 *                    instant it is allocated. No hardware can do this -- at allocation the
 *                    branch has not resolved and the machine does not know. It is the cleanest
 *                    signal for CALIBRATION, because the cost distribution it produces contains
 *                    only misses that mattered, which is what the quantization edges should be
 *                    cut from.
 *
 *   the paper        CONFIRM-AND-RETRACT. "All misses are treated on correct path until they
 *                    are confirmed to be on the wrong path." A miss counts from allocation and
 *                    is dropped at branch resolution. Reachable here only via Scarab's
 *                    off_path_confirmed, which needs --set_off_path_confirmed 1 (it is never
 *                    written otherwise) and is NOT what this knob selects. Note the paper's own
 *                    scheme carries a dilution it does not discuss: until confirmation, a
 *                    wrong-path miss is in N and deflates the cost charged to the correct-path
 *                    misses it overlaps, and that charge is never corrected afterwards.
 *
 *   TRUE             NO GATING. Every demand MSHR occupant accrues cost and counts toward N,
 *                    wrong-path included, for its whole lifetime. This models hardware that
 *                    simply does not implement the confirm-and-retract logic -- the cheapest
 *                    real design, and a defensible one.
 *
 * WHAT CHANGES WHEN IT IS ON. Scarab never squashes an off-path request: recover_memory() only
 * stamps a flag (and only when --set_off_path_confirmed is on), so a wrong-path miss keeps its
 * MSHR entry, consumes bandwidth, completes, and FILLS THE CACHE. Today those fills carry cost
 * 0, quantize to level 0 and are evicted first under REPL_MLP -- a real effect on the policy
 * that arrives by accident rather than by design. With this knob on they carry genuine cost and
 * compete for retention like anything else, so a LIN result can shift for that reason alone.
 * N also rises, so on-path misses are charged a smaller share and mean cost falls.
 *
 * Costs measured with this on are NOT comparable to costs measured with it off, and the
 * quantization edges in cache_lib.c were cut with it off. */
DEF_PARAM(mlp_cost_include_offpath, MLP_COST_INCLUDE_OFFPATH, Flag, Flag, FALSE, )

