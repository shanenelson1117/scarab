DEF_PARAM(mlc_cache_repl_policy, MLC_CACHE_REPL_POLICY, uns, uns, 0, )
DEF_PARAM(mlc_write_through, MLC_WRITE_THROUGH, Flag, Flag, FALSE, )
DEF_PARAM(prefetch_update_lru_mlc, PREFETCH_UPDATE_LRU_MLC, Flag, Flag, TRUE, )
